<?xml version="1.0" encoding="UTF-8"?>
<!-- Lumen detail page. Kodi wires: 8 play/browse, 11 trailer, 14 versions, 15 extras, 10 artwork, 6 refresh, 50 cast (or set movies). -->
<window>
	<defaultcontrol always="true">8</defaultcontrol>
	<controls>
		<!-- backdrop -->
		<control type="group">
			<animation effect="fade" start="0" end="100" time="360" tween="sine" easing="out">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="220">WindowClose</animation>
			<control type="image">
				<include>FullScreenDimensions</include>
				<texture colordiffuse="background">lumen/white.png</texture>
			</control>
			<control type="group">
				<include>LumenKenBurns</include>
				<animation effect="zoom" start="104" end="100" center="960,540" time="1400" tween="cubic" easing="out">WindowOpen</animation>
				<control type="image">
					<include>FullScreenDimensions</include>
					<aspectratio>scale</aspectratio>
					<fadetime>400</fadetime>
					<texture background="true">$VAR[LumenInfoFanart]</texture>
				</control>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<texture>lumen/hero_scrim.png</texture>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<texture colordiffuse="99000000">lumen/white.png</texture>
				<animation effect="fade" start="0" end="100" time="400" tween="sine" easing="out" condition="$EXP[LumenCastFocus]">Conditional</animation>
			</control>
		</control>

		<!-- page content; slides up when the cast row takes focus -->
		<control type="group">
			<animation effect="slide" end="0,-340" time="460" tween="cubic" easing="out" condition="$EXP[LumenCastFocus]">Conditional</animation>
			<control type="group">
				<left>lm_margin</left>
				<top>130</top>
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="480" delay="120" tween="sine" easing="out" />
					<effect type="slide" start="0,40" end="0,0" time="620" delay="120" tween="cubic" easing="out" />
				</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<animation effect="fade" start="100" end="20" time="400" condition="$EXP[LumenCastFocus]">Conditional</animation>
				<!-- logo / title -->
				<control type="image">
					<width>720</width>
					<height>230</height>
					<aspectratio align="left" aligny="bottom">keep</aspectratio>
					<texture background="true">$VAR[LumenInfoLogo]</texture>
				</control>
				<control type="textbox">
					<top>30</top>
					<width>1100</width>
					<height>200</height>
					<aligny>bottom</aligny>
					<font>lm_title_l</font>
					<textcolor>text</textcolor>
					<shadowcolor>text_shadow</shadowcolor>
					<label>$VAR[LumenInfoTitle]</label>
					<visible>String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
				</control>
				<!-- text block, anchored to the buttons; as wide as the info line, which a long line's logo needs (a grouplist
				     clips what overflows it) -->
				<control type="grouplist">
					<top>240</top>
					<width>1700</width>
					<height>330</height>
					<orientation>vertical</orientation>
					<align>right</align>
					<itemgap>14</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
						<width>1100</width>
						<height>40</height>
						<font>lm_headline</font>
						<textcolor>text</textcolor>
						<label>$VAR[LumenInfoSubtitle]</label>
						<visible>!String.IsEmpty(ListItem.Tagline) | String.IsEqual(ListItem.DBType,season)</visible>
					</control>
					<control type="group">
						<width>1700</width>
						<height>34</height>
						<include content="LumenMetaLine">
							<param name="item" value="ListItem" />
							<param name="width" value="1700" />
							<param name="height" value="64" />
							<param name="inset" value="15" />
							<param name="top" value="-15" />
							<param name="logo" value="true" />
							<param name="logo_id" value="6170" />
						</include>
					</control>
					<control type="textbox">
						<width>960</width>
						<height min="38" max="158">auto</height>
						<font>lm_body_l</font>
						<textcolor>text_dim</textcolor>
						<label>$INFO[ListItem.Plot]</label>
						<!-- $EXP isn't expanded in autoscroll: LumenCastFocus written out -->
						<autoscroll delay="8000" time="3000" repeat="8000">![Control.HasFocus(50) | Control.HasFocus(6051) | Control.HasFocus(5060)]</autoscroll>
					</control>
					<control type="label">
						<width>960</width>
						<height>30</height>
						<font>lm_caption</font>
						<textcolor>text_mute</textcolor>
						<label>$INFO[ListItem.Director,Director  ,]$INFO[ListItem.Studio,     Studio  ,]</label>
						<visible>!String.IsEmpty(ListItem.Director) | !String.IsEmpty(ListItem.Studio)</visible>
					</control>
				</control>

				<!-- actions -->
				<control type="grouplist" id="9000">
					<top>584</top>
					<width>1300</width>
					<height>96</height>
					<orientation>horizontal</orientation>
					<itemgap>18</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<ondown condition="!String.IsEqual(ListItem.DBType,set) + Integer.IsGreater(Container(50).NumItems,0)">6051</ondown>
					<ondown condition="String.IsEqual(ListItem.DBType,set)">50</ondown>
					<!-- a film with directors and no cast (a documentary): its directors -->
					<ondown condition="!String.IsEqual(ListItem.DBType,set) + !Integer.IsGreater(Container(50).NumItems,0)">5060</ondown>
					<control type="group" id="9001">
						<width>264</width>
						<height>80</height>
						<animation effect="zoom" start="100" end="106" center="132,40" time="200" tween="cubic" easing="out" reversible="false" condition="Control.HasFocus(8)">Conditional</animation>
						<control type="image">
							<left>-30</left>
							<top>-20</top>
							<width>324</width>
							<height>124</height>
							<texture border="52">lumen/shadow_card.png</texture>
							<visible>Control.HasFocus(8)</visible>
						</control>
						<control type="button" id="8">
							<!-- kids mode: Kodi's Browse opens a show, season or set without "return", so Back would climb into every TV show -->
							<visible>!$EXP[LumenKids] | ![String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,set)]</visible>
							<width>264</width>
							<height>80</height>
							<label>$VAR[LumenInfoPlayLabel]</label>
							<font>lm_label_bold</font>
							<textoffsetx>86</textoffsetx>
							<aligny>center</aligny>
							<textcolor>text</textcolor>
							<focusedcolor>focus_text</focusedcolor>
							<texturefocus border="32" colordiffuse="FFFFFFFF">lumen/pill.png</texturefocus>
							<texturenofocus border="32" colordiffuse="2EFFFFFF">lumen/pill.png</texturenofocus>
							<!-- leaving for a player or a listing: an actor page below (this title was opened on it) closes
							     first, without bringing back the page it came from, or Kodi refuses the window change -->
							<onclick>ClearProperty(lumen.personreopen,home)</onclick>
							<onclick>Dialog.Close(1115,true)</onclick>
							<!-- Kodi handles the click first: its Browse to a show's seasons was refused while the actor page was
							     open, so go there again (the same path as GUIDialogVideoInfo::Play) -->
							<onclick condition="Window.IsVisible(1115) + String.IsEqual(ListItem.DBType,tvshow)">ActivateWindow(Videos,videodb://tvshows/titles/$INFO[ListItem.DBID]/)</onclick>
							<onup>noop</onup>
							<ondown condition="!String.IsEqual(ListItem.DBType,set) + Integer.IsGreater(Container(50).NumItems,0)">6051</ondown>
							<ondown condition="String.IsEqual(ListItem.DBType,set)">50</ondown>
							<ondown condition="!String.IsEqual(ListItem.DBType,set) + !Integer.IsGreater(Container(50).NumItems,0)">5060</ondown>
						</control>
						<control type="image">
							<left>40</left>
							<top>24</top>
							<width>32</width>
							<height>32</height>
							<texture colordiffuse="focus_text">$VAR[LumenInfoPlayIcon]</texture>
							<visible>Control.HasFocus(8)</visible>
						</control>
						<control type="image">
							<left>40</left>
							<top>24</top>
							<width>32</width>
							<height>32</height>
							<texture colordiffuse="text">$VAR[LumenInfoPlayIcon]</texture>
							<visible>!Control.HasFocus(8)</visible>
						</control>
						<control type="group">
							<left>40</left>
							<top>68</top>
							<visible>ListItem.IsResumable</visible>
							<include content="LumenProgress">
								<param name="width" value="184" />
								<param name="height" value="4" />
								<param name="info" value="ListItem.PercentPlayed" />
							</include>
						</control>
					</control>
					<include content="LumenPillButton">
						<param name="id" value="11" />
						<param name="label" value="$LOCALIZE[20410]" />
						<param name="onclick0" value="ClearProperty(lumen.personreopen,home)" />
						<param name="onclick" value="Dialog.Close(1115,true)" />
						<param name="visible" value="!String.IsEmpty(ListItem.Trailer) + !$EXP[LumenKids]" />
					</include>
					<include content="LumenPillButton">
						<param name="id" value="14" />
						<param name="label" value="$LOCALIZE[40000]" />
						<param name="visible" value="String.IsEqual(ListItem.DBType,movie) + ListItem.HasVideoVersions + !$EXP[LumenKids]" />
					</include>
					<include content="LumenPillButton">
						<param name="id" value="15" />
						<param name="label" value="$LOCALIZE[40211]" />
						<param name="visible" value="String.IsEqual(ListItem.DBType,movie) + ListItem.HasVideoExtras + !$EXP[LumenKids]" />
					</include>
					<include content="LumenPillButton">
						<param name="id" value="443" />
						<param name="label" value="Collection" />
						<param name="onclick0" value="ClearProperty(lumen.personreopen,home)" />
						<param name="onclick" value="Dialog.Close(all,true)" />
						<param name="onclick2" value="ActivateWindow(Videos,videodb://movies/sets/$INFO[ListItem.SetId]/?setid=$INFO[ListItem.SetId],return)" />
						<param name="visible" value="!String.IsEmpty(ListItem.SetID) + !String.IsEqual(ListItem.SetID,0) + !$EXP[LumenKids]" />
					</include>
					<include content="LumenPillButtonSmall">
						<param name="id" value="10" />
						<param name="label" value="$LOCALIZE[13511]" />
						<param name="visible" value="Control.IsEnabled(10) + !$EXP[LumenKids]" />
					</include>
					<include content="LumenPillButtonSmall">
						<param name="id" value="6" />
						<param name="label" value="$LOCALIZE[184]" />
						<param name="visible" value="Control.IsEnabled(6) + !$EXP[LumenKids]" />
					</include>
				</control>
			</control>

			<!-- technical details, right column -->
			<control type="group">
				<right>80</right>
				<top>714</top>
				<width>560</width>
				<animation effect="fade" start="0" end="100" time="500" delay="300">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<visible>!String.IsEmpty(ListItem.VideoCodec) | !String.IsEmpty(ListItem.AudioCodec)</visible>
				<animation effect="fade" start="100" end="0" time="300" condition="$EXP[LumenCastFocus]">Conditional</animation>
				<control type="label">
					<width>560</width>
					<height>34</height>
					<align>right</align>
					<font>lm_caption</font>
					<textcolor>text_mute</textcolor>
					<label>$VAR[LumenInfoVideoLine]</label>
				</control>
				<control type="label">
					<top>34</top>
					<width>560</width>
					<height>34</height>
					<align>right</align>
					<font>lm_caption</font>
					<textcolor>text_mute</textcolor>
					<label>$VAR[LumenInfoAudioLine]</label>
				</control>
				<control type="label">
					<top>68</top>
					<width>560</width>
					<height>34</height>
					<align>right</align>
					<font>lm_caption</font>
					<textcolor>text_mute</textcolor>
					<label>$INFO[ListItem.SubtitleLanguage,Subtitles  ]</label>
				</control>
			</control>

			<!-- cast & crew / movies in set; not in kids mode: people lead to searches of the whole library -->
			<control type="group" id="6050">
				<top>820</top>
				<!-- on every film page: the directors (5060) only load while it shows, and a film may have no cast -->
				<visible>!$EXP[LumenKids] + [Integer.IsGreater(Container(50).NumItems,0) | Container(50).IsUpdating | String.IsEqual(ListItem.DBType,movie)]</visible>
				<animation effect="fade" start="0" end="100" time="500" delay="260">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<control type="label">
					<left>lm_margin</left>
					<width>1000</width>
					<height>44</height>
					<font>lm_headline</font>
					<textcolor>E6FFFFFF</textcolor>
					<label>$VAR[LumenInfoRowHeader]</label>
					<visible>Integer.IsGreater(Container(50).NumItems,0) | Container(50).IsUpdating | Integer.IsGreater(Container(5060).NumItems,0)</visible>
				</control>
				<!-- a film's directors, in front of the cast: they slide away as the row moves on, like one row -->
				<control type="list" id="5060">
					<left>80</left>
					<top>52</top>
					<width>648</width>
					<height>420</height>
					<orientation>horizontal</orientation>
					<!-- always visible (an empty list draws nothing): a hidden list isn't processed and keeps its old items -->
					<animation effect="slide" end="-216,0" time="320" tween="cubic" easing="out" condition="Integer.IsEqual(Container(5060).NumItems,1) + !$EXP[LumenDirFront1]">Conditional</animation>
					<animation effect="slide" end="-432,0" time="320" tween="cubic" easing="out" condition="Integer.IsEqual(Container(5060).NumItems,2) + !$EXP[LumenDirFront2]">Conditional</animation>
					<animation effect="slide" end="-648,0" time="320" tween="cubic" easing="out" condition="Integer.IsGreater(Container(5060).NumItems,2) + !$EXP[LumenDirFront3]">Conditional</animation>
					<animation effect="fade" start="100" end="0" time="200" condition="!$EXP[LumenDirFront1] + !$EXP[LumenDirFront2] + !$EXP[LumenDirFront3]">Conditional</animation>
					<onleft>noop</onleft>
					<onright condition="Integer.IsGreater(Container(50).NumItems,0)">6051</onright>
					<onright condition="!Integer.IsGreater(Container(50).NumItems,0)">noop</onright>
					<onup>9000</onup>
					<ondown>noop</ondown>
					<onback>8</onback>
					<onclick>SetProperty(lumen.person,$ESCINFO[Container(5060).ListItem.Label],home)</onclick>
					<onclick>SetProperty(lumen.personthumb,$ESCINFO[Container(5060).ListItem.Art(thumb)],home)</onclick>
					<onclick>SetProperty(lumen.personfrom,detail,home)</onclick>
					<!-- this page was opened from an actor page (still open below): close it, that page now shows this person -->
					<onclick condition="Window.IsVisible(1115)">Dialog.Close(movieinformation,true)</onclick>
					<onclick condition="!Window.IsVisible(1115)">ActivateWindow(1115)</onclick>
					<itemlayout width="216" height="320">
						<include content="LumenPersonCard">
							<param name="role" value="Director" />
						</include>
					</itemlayout>
					<focusedlayout width="216" height="320">
						<control type="group">
							<include content="LumenCardFocus">
								<param name="cx" value="108" />
								<param name="cy" value="110" />
							</include>
							<include content="LumenPersonCard">
								<param name="focused" value="Control.HasFocus(5060)" />
								<param name="role" value="Director" />
							</include>
						</control>
					</focusedlayout>
					<content limit="3">$VAR[LumenInfoDirectorsPath]</content>
				</control>
				<!-- OK on Kodi's cast list runs Kodi's search (a Searching… box, then a list of results), and a skin
				     onclick never runs on a list Kodi fills itself. This stands in for the list on people pages: it moves
				     the list and opens the actor page (Custom_1115_LumenPerson.xml). Collection pages keep Kodi's list. -->
				<control type="button" id="6051">
					<left>80</left>
					<top>52</top>
					<width>1</width>
					<height>1</height>
					<texturefocus />
					<texturenofocus />
					<visible>!String.IsEqual(ListItem.DBType,set) + Integer.IsGreater(Container(50).NumItems,0)</visible>
					<onleft condition="Integer.IsEqual(Container(50).CurrentItem,1) + Integer.IsGreater(Container(5060).NumItems,0) + String.IsEqual(ListItem.DBType,movie)">SetFocus(5060)</onleft>
					<onleft condition="!Integer.IsEqual(Container(50).CurrentItem,1) | !Integer.IsGreater(Container(5060).NumItems,0) | !String.IsEqual(ListItem.DBType,movie)">Control.Move(50,-1)</onleft>
					<onright>Control.Move(50,1)</onright>
					<onup>9000</onup>
					<ondown>noop</ondown>
					<onback>8</onback>
					<onclick>SetProperty(lumen.person,$ESCINFO[Container(50).ListItem.Label],home)</onclick>
					<onclick>SetProperty(lumen.personthumb,$ESCINFO[Container(50).ListItem.Art(thumb)],home)</onclick>
					<onclick>SetProperty(lumen.personfrom,detail,home)</onclick>
					<!-- this page was opened from an actor page (still open below): close it, that page now shows this person -->
					<onclick condition="Window.IsVisible(1115)">Dialog.Close(movieinformation,true)</onclick>
					<onclick condition="!Window.IsVisible(1115)">ActivateWindow(1115)</onclick>
				</control>
				<control type="list" id="50">
					<left>80</left>
					<top>52</top>
					<width>1840</width>
					<height>420</height>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">320</scrolltime>
					<onup>9000</onup>
					<ondown>noop</ondown>
					<onback>8</onback>
					<onfocus condition="!String.IsEqual(ListItem.DBType,set)">SetFocus(6051)</onfocus>
					<animation effect="slide" end="216,0" time="320" tween="cubic" easing="out" condition="$EXP[LumenDirFront1]">Conditional</animation>
					<animation effect="slide" end="432,0" time="320" tween="cubic" easing="out" condition="$EXP[LumenDirFront2]">Conditional</animation>
					<animation effect="slide" end="648,0" time="320" tween="cubic" easing="out" condition="$EXP[LumenDirFront3]">Conditional</animation>
					<!-- people -->
					<itemlayout width="216" height="320" condition="!String.IsEqual(ListItem.DBType,set)">
						<include content="LumenPersonCard" />
					</itemlayout>
					<focusedlayout width="216" height="320" condition="!String.IsEqual(ListItem.DBType,set)">
						<control type="group">
							<!-- the list itself never has focus here, so its Focus animation can't run -->
							<animation effect="zoom" start="100" end="110" center="108,110" time="260" tween="cubic" easing="out" condition="Control.HasFocus(6051)">Conditional</animation>
							<include content="LumenPersonCard">
								<param name="focused" value="$EXP[LumenCastFocus]" />
							</include>
						</control>
					</focusedlayout>
					<!-- movies in a collection -->
					<itemlayout width="240" height="420" condition="String.IsEqual(ListItem.DBType,set)">
						<control type="group">
							<left>30</left>
							<top>14</top>
							<include>LumenPosterCard</include>
						</control>
					</itemlayout>
					<focusedlayout width="240" height="420" condition="String.IsEqual(ListItem.DBType,set)">
						<control type="group">
							<left>30</left>
							<top>14</top>
							<include content="LumenCardFocus">
								<param name="cx" value="105" />
								<param name="cy" value="157" />
							</include>
							<include content="LumenPosterCard">
								<param name="focused" value="$EXP[LumenCastFocus]" />
							</include>
						</control>
					</focusedlayout>
				</control>
			</control>
			<!-- More like this: the film's collection, its directors, its first genre (a show: its first genre) -->
			<include content="LumenNextLookup">
				<param name="id" value="5161" />
				<param name="path" value="$VAR[LumenMoreDirectorsPath]" />
				<param name="limit" value="3" />
			</include>
			<control type="group" id="6070">
				<top>1320</top>
				<animation effect="fade" start="0" end="100" time="500" delay="260">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<include content="LumenMoreRow">
					<param name="id" value="5171" />
					<param name="header_id" value="6171" />
					<param name="header" value="$INFO[ListItem.Set]" />
					<param name="path" value="$VAR[LumenMoreSetPath]" />
					<param name="sortby" value="year" />
					<param name="sortorder" value="ascending" />
					<param name="limit" value="25" />
					<param name="top" value="0" />
					<param name="onup" value="9000" />
					<param name="ondown" value="noop" />
				</include>
				<include content="LumenMoreRow">
					<param name="id" value="5172" />
					<param name="header_id" value="6172" />
					<param name="header" value="$INFO[ListItem.Director,Directed by ]" />
					<param name="path" value="$VAR[LumenMoreDirectorPath]" />
					<param name="sortby" value="year" />
					<param name="top" value="500" />
					<param name="onup" value="9000" />
					<param name="ondown" value="noop" />
				</include>
				<include content="LumenMoreRow">
					<param name="id" value="5173" />
					<param name="header_id" value="6173" />
					<param name="header" value="More $VAR[LumenMoreGenre]" />
					<param name="path" value="$VAR[LumenMoreGenrePath]" />
					<param name="sortby" value="rating" />
					<param name="top" value="1000" />
					<param name="onup" value="9000" />
					<param name="ondown" value="noop" />
				</include>
			</control>
		</control>
		<include>LumenClock</include>
	</controls>
</window>
