<?xml version="1.0" encoding="UTF-8"?>
<!-- A guide entry's info (pvrguideinfo: → in the channel list, OK on a future programme in the guide) and a recording's
     (pvrrecordinginfo): the programme card (LumenLiveProgramme) with the buttons of Kodi's that apply here: Switch to the
     channel, Play recording, Set reminder (not for kids), Close. Kodi hides those that don't apply to the entry. -->
<!-- The guide info's buttons don't test Window.IsActive(pvrguideinfo): it turns false while the dialog closes, and
     at the next opening Kodi picks the focus before the buttons are shown again (Close got it, not Switch). -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="240" tween="sine" easing="out">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200" tween="sine" easing="in">WindowClose</animation>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>1920</width>
				<height>760</height>
				<texture colordiffuse="CC000000">lumen/grad_v.png</texture>
			</control>
			<include content="LumenLiveProgramme">
				<param name="src" value="ListItem" />
				<param name="hasepg" value="[ListItem.HasEpg | Window.IsActive(pvrrecordinginfo)]" />
				<param name="live" value="$EXP[LumenTvOnNow]" />
				<param name="pic" value="ListItem.EpgEventIcon" />
				<param name="logo" value="ListItem.Icon" />
				<param name="progress" value="ListItem.Progress" />
				<param name="when" value="$VAR[LumenTvWhen]" />
			</include>
			<control type="grouplist" id="9000">
				<left>676</left>
				<top>916</top>
				<width>1124</width>
				<height>60</height>
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<include content="LumenTvButton">
					<param name="id" value="5" />
					<param name="label" value="$LOCALIZE[19165]" />
					<!-- Kodi closes this and switches first; the channel list it came from goes too -->
					<param name="onclick" value="Dialog.Close(pvrosdchannels)" />
					<param name="visible" value="!Window.IsActive(pvrrecordinginfo)" />
				</include>
				<include content="LumenTvButton">
					<param name="id" value="8" />
					<param name="label" value="$LOCALIZE[19687]" />
					<param name="onclick" value="noop" />
					<param name="visible" value="Window.IsActive(pvrrecordinginfo)" />
				</include>
				<include content="LumenTvButton">
					<param name="id" value="11" />
					<param name="label" value="$LOCALIZE[826]" />
					<param name="onclick" value="noop" />
					<param name="visible" value="!Window.IsActive(pvrrecordinginfo) + !$EXP[LumenKids]" />
				</include>
				<include content="LumenTvButton">
					<param name="id" value="7" />
					<param name="label" value="$LOCALIZE[15067]" />
					<param name="onclick" value="noop" />
				</include>
			</control>
		</control>
		<include condition="Skin.HasSetting(touchmode)">TouchBackButton</include>
	</controls>
</window>
