<?xml version="1.0" encoding="UTF-8"?>
<!-- Genre / Decade picker, opened by the Genre and Decade chips above a film or show grid (LumenQuickFilterBar).
     Window(home).Property(lumen.fpick) says which. OK on a genre ticks or unticks it; a decade, All genres or Done
     closes (so does Back). The picks are Home window properties; closing after a change opens the grid at $VAR[LumenFilterPath] and
     keeps that in lumen.fpath. Actions and paths are generated by tools/build_filters.py (Includes_LumenFilters.xml).
     Container.* here is the grid's. -->
<window type="dialog" id="1117">
	<!-- the group focuses its first visible control: All genres, or the decade list -->
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>LumenFilterResetOnload</include>
	<onload>ClearProperty(lumen.fdirty,home)</onload>
	<!-- the lists would reopen on the row picked last time, away from the tick: back to the top -->
	<onload condition="String.IsEqual(Window(home).Property(lumen.fpick),genre)">SetFocus(11,0,absolute)</onload>
	<onload condition="String.IsEqual(Window(home).Property(lumen.fpick),genre)">SetFocus(10)</onload>
	<onload condition="!String.IsEqual(Window(home).Property(lumen.fpick),genre)">SetFocus(12,0,absolute)</onload>
	<!-- after a change, the grid's new path as the window's start folder ("return" with "replace", GUIMediaWindow.cpp)
	     so Back still goes Home. The conditions are all read before the first action runs -->
	<onunload condition="!String.IsEmpty(Window(home).Property(lumen.fdirty))">SetProperty(lumen.fpath,$VAR[LumenFilterPath],home)</onunload>
	<onunload condition="!String.IsEmpty(Window(home).Property(lumen.fdirty))">ClearProperty(lumen.fdirty,home)</onunload>
	<onunload condition="!String.IsEmpty(Window(home).Property(lumen.fdirty))">ActivateWindow(videos,$INFO[Window(home).Property(lumen.fpath)],return,replace)</onunload>
	<include>Animation_DialogPopupOpenClose</include>
	<depth>DepthDialog+</depth>
	<controls>
		<!-- the genre list again, unseen: which ticked genres list 11 doesn't have (LumenGenreVanishedItems) -->
		<include content="LumenNextLookup">
			<param name="id" value="9100" />
			<param name="path" value="$VAR[LumenGenreSource]" />
		</include>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>880</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="880" />
				<param name="header_label" value="$VAR[LumenPickerTitle]" />
				<param name="header_id" value="" />
			</include>
			<control type="group" id="9000">
				<!-- closes, opening what's ticked (no count: listing every film to count it takes the Pi 10 seconds) -->
				<control type="button" id="13">
					<left>40</left>
					<top>96</top>
					<width>520</width>
					<height>72</height>
					<label>Done</label>
					<font>lm_label_bold</font>
					<textoffsetx>32</textoffsetx>
					<aligny>center</aligny>
					<textcolor>text</textcolor>
					<focusedcolor>focus_text</focusedcolor>
					<texturefocus border="32" colordiffuse="FFFFFFFF">lumen/pill.png</texturefocus>
					<texturenofocus border="32" colordiffuse="4DFFFFFF">lumen/pill.png</texturenofocus>
					<onup>11</onup>
					<ondown>10</ondown>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<onclick>Dialog.Close(1117)</onclick>
					<visible>String.IsEqual(Window(home).Property(lumen.fpick),genre)</visible>
				</control>
				<control type="radiobutton" id="10">
					<left>40</left>
					<top>178</top>
					<width>520</width>
					<height>72</height>
					<label>All genres</label>
					<font>lm_label_bold</font>
					<textoffsetx>32</textoffsetx>
					<aligny>center</aligny>
					<textcolor>text</textcolor>
					<focusedcolor>focus_text</focusedcolor>
					<texturefocus border="32" colordiffuse="FFFFFFFF">lumen/pill.png</texturefocus>
					<texturenofocus border="32" colordiffuse="14FFFFFF">lumen/pill.png</texturenofocus>
					<radioposx>460</radioposx>
					<radioposy>22</radioposy>
					<radiowidth>28</radiowidth>
					<radioheight>28</radioheight>
					<textureradioonfocus colordiffuse="focus_text">lumen/icons/check.png</textureradioonfocus>
					<textureradioonnofocus colordiffuse="text">lumen/icons/check.png</textureradioonnofocus>
					<textureradioofffocus />
					<textureradiooffnofocus />
					<selected>String.IsEmpty(Window(home).Property(lumen.fgenres))</selected>
					<onup>13</onup>
					<ondown>11</ondown>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<include>LumenAllGenresActions</include>
					<visible>String.IsEqual(Window(home).Property(lumen.fpick),genre)</visible>
				</control>
				<control type="list" id="12">
					<left>40</left>
					<top>96</top>
					<width>520</width>
					<height>754</height>
					<orientation>vertical</orientation>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<include content="LumenPickerLayouts">
						<param name="list" value="12" />
						<param name="selected" value="[!String.IsEmpty(Window(home).Property(lumen.fdecade)) + String.IsEqual(ListItem.Label,Window(home).Property(lumen.fdecade))] | [String.IsEmpty(Window(home).Property(lumen.fdecade)) + String.IsEqual(ListItem.Property(all),1)]" />
					</include>
					<content>
						<include>LumenDecadeItems</include>
					</content>
					<visible>!String.IsEqual(Window(home).Property(lumen.fpick),genre)</visible>
				</control>
				<!-- Kodi's genres for films or shows that have titles here (kids tag, decade), A to Z; first, dimmed, a
				     ticked genre without titles here (a decade picked after it), so it can be unticked -->
				<control type="list" id="11">
					<left>40</left>
					<top>260</top>
					<width>520</width>
					<height>590</height>
					<orientation>vertical</orientation>
					<onup>10</onup>
					<ondown>13</ondown>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<scrolltime tween="quadratic" easing="out">200</scrolltime>
					<include content="LumenPickerLayouts">
						<param name="list" value="11" />
						<param name="selected" value="$EXP[LumenGenreTicked]" />
						<param name="dim" value="!$EXP[LumenGenreKnown] | String.IsEqual(ListItem.Property(vanished),1)" />
					</include>
					<content>
						<include>LumenGenreVanishedItems</include>
					</content>
					<content sortby="label" sortorder="ascending">$VAR[LumenGenreSource]</content>
					<include>LumenGenrePickActions</include>
					<visible>String.IsEqual(Window(home).Property(lumen.fpick),genre)</visible>
				</control>
			</control>
		</control>
	</controls>
</window>
