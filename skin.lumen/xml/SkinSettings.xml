<?xml version="1.0" encoding="UTF-8"?>
<!-- Lumen skin settings (Settings > Interface > Skin > Configure skin). -->
<window>
	<onload condition="$EXP[LumenKids]">ReplaceWindow(home)</onload>
	<defaultcontrol always="true">9000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>DefaultBackground</include>
		<control type="group">
			<include>LumenFadeInWindow</include>
			<control type="label">
				<left>lm_margin</left>
				<top>52</top>
				<width>1100</width>
				<height>66</height>
				<font>lm_title</font>
				<textcolor>text</textcolor>
				<label>Lumen</label>
			</control>
			<control type="label">
				<left>lm_margin</left>
				<top>118</top>
				<width>1100</width>
				<height>36</height>
				<font>lm_caption</font>
				<textcolor>text_mute</textcolor>
				<label>Skin settings$INFO[System.AddonVersion(skin.lumen),  ·  version ]</label>
			</control>
		</control>
		<include>LumenClock</include>
		<control type="grouplist" id="9000">
			<left>80</left>
			<top>200</top>
			<width>960</width>
			<height>800</height>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<include>LumenRiseIn</include>
			<control type="radiobutton" id="901">
				<label>Animated backdrops</label>
				<include>DefaultSettingButton</include>
				<selected>Skin.HasSetting(lumen_kenburns)</selected>
				<onclick>Skin.ToggleSetting(lumen_kenburns)</onclick>
			</control>
			<!-- kids mode PIN: asked twice when set; Custom_1113_LumenPin.xml compares and stores it -->
			<control type="button" id="902">
				<label>Set kids PIN</label>
				<include>DefaultSettingButton</include>
				<onclick>SetProperty(lumen.pinflow,set,home)</onclick>
				<onclick>SetProperty(lumen.pinprompt,new,home)</onclick>
				<onclick>Skin.Reset(lumen.pinnew)</onclick>
				<onclick>Skin.SetNumeric(lumen.pinnew)</onclick>
				<onclick>SetProperty(lumen.pinprompt,again,home)</onclick>
				<onclick>Skin.Reset(lumen.pinentry)</onclick>
				<onclick>Skin.SetNumeric(lumen.pinentry)</onclick>
				<onclick>ClearProperty(lumen.pinprompt,home)</onclick>
				<onclick>ActivateWindow(1113)</onclick>
				<visible>String.IsEmpty(Skin.String(lumen.pin))</visible>
			</control>
			<control type="button" id="903">
				<label>Remove kids PIN</label>
				<include>DefaultSettingButton</include>
				<onclick>SetProperty(lumen.pinflow,remove,home)</onclick>
				<onclick>SetProperty(lumen.pinprompt,current,home)</onclick>
				<onclick>Skin.Reset(lumen.pinentry)</onclick>
				<onclick>Skin.SetNumeric(lumen.pinentry)</onclick>
				<onclick>ClearProperty(lumen.pinprompt,home)</onclick>
				<onclick>ActivateWindow(1113)</onclick>
				<visible>!String.IsEmpty(Skin.String(lumen.pin))</visible>
			</control>
			<!-- next episode card: 30 s, 60 s, 90 s or off (Skin.String(lumen.nextcard): empty, 60, 90, off) -->
			<control type="button" id="904">
				<label>Next episode card</label>
				<label2>$VAR[LumenNextCardSecs]</label2>
				<include>DefaultSettingButton</include>
				<onclick condition="String.IsEmpty(Skin.String(lumen.nextcard))">Skin.SetString(lumen.nextcard,60)</onclick>
				<onclick condition="String.IsEqual(Skin.String(lumen.nextcard),60)">Skin.SetString(lumen.nextcard,90)</onclick>
				<onclick condition="String.IsEqual(Skin.String(lumen.nextcard),90)">Skin.SetString(lumen.nextcard,off)</onclick>
				<onclick condition="String.IsEqual(Skin.String(lumen.nextcard),off)">Skin.Reset(lumen.nextcard)</onclick>
			</control>
			<!-- generated by tools/build_home.py (Includes_LumenHome.xml), with the rows it builds -->
			<include>LumenHomeRowSettings</include>
		</control>
		<!-- help card for the focused setting -->
		<control type="group">
			<left>1120</left>
			<top>200</top>
			<width>700</width>
			<include>LumenRiseIn</include>
			<control type="image">
				<width>700</width>
				<height>260</height>
				<texture border="28" colordiffuse="glass">lumen/rr28.png</texture>
			</control>
			<control type="image">
				<width>700</width>
				<height>260</height>
				<texture border="28" colordiffuse="stroke">lumen/rr28_stroke1.png</texture>
			</control>
			<control type="textbox">
				<left>40</left>
				<top>34</top>
				<width>620</width>
				<height>200</height>
				<font>lm_body</font>
				<textcolor>text_dim</textcolor>
				<label>$VAR[LumenSkinSettingHelp]</label>
			</control>
		</control>
	</controls>
</window>
