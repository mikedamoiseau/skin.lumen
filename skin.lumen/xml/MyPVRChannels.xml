<?xml version="1.0" encoding="UTF-8"?>
<!-- Live TV channels, full screen: the channel list's rows (DialogPVRChannelsOSD.xml) on the left, the focused channel's
     programme on the right. Kids open it from Home's Live TV tab on the Kids group, and only that way; Lumen opens the
     guide for everyone else. OK plays the channel, → opens its programme info. -->
<window>
	<onload condition="$EXP[LumenKids] + !String.IsEqual(Container.FolderPath,Window(home).Property(lumen.tv.kids))">ReplaceWindow(home)</onload>
	<defaultcontrol always="true">50</defaultcontrol>
	<!-- a plain dark backdrop: the usual fanart backdrop reloads with every move (slow on the Pi) -->
	<backgroundcolor>primary_background</backgroundcolor>
	<views>50</views>
	<controls>
		<!-- Kodi's channel group selector. Lumen has none, but Kodi keeps a pointer to the one it found last: after a skin
		     reload or a skin switch it would point at a freed control and crash the window's first opening -->
		<control type="list" id="11">
			<width>1</width>
			<height>1</height>
			<itemlayout width="1" height="1" />
			<focusedlayout width="1" height="1" />
			<visible>false</visible>
		</control>
		<control type="group">
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
			<include>LumenFadeInWindow</include>
			<control type="label">
				<left>64</left>
				<top>44</top>
				<width>900</width>
				<height>62</height>
				<aligny>center</aligny>
				<font>lm_title</font>
				<textcolor>text</textcolor>
				<label>$VAR[LumenTvListTitle]</label>
			</control>
			<include>LumenClock</include>
			<control type="fixedlist" id="50">
				<left>64</left>
				<top>150</top>
				<width>716</width>
				<height>900</height>
				<onup>50</onup>
				<ondown>50</ondown>
				<onright>Action(Info)</onright>
				<movement>4</movement>
				<focusposition>4</focusposition>
				<scrolltime tween="cubic" easing="out">240</scrolltime>
				<viewtype label="535">list</viewtype>
				<itemlayout height="90" infoupdate="5000">
					<include>LumenTvRowLogo</include>
					<include content="LumenTvRowText">
						<param name="number" value="text_mute" />
						<param name="text" value="text" />
						<param name="dim" value="text_dim" />
						<param name="track" value="2EFFFFFF" />
						<param name="fill" value="accent" />
					</include>
				</itemlayout>
				<focusedlayout height="90" infoupdate="5000">
					<control type="image">
						<width>716</width>
						<height>84</height>
						<texture border="20" colordiffuse="FFFFFFFF">lumen/rr20.png</texture>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="image">
						<width>716</width>
						<height>84</height>
						<texture border="20" colordiffuse="glass_light">lumen/rr20.png</texture>
						<visible>!Control.HasFocus(50)</visible>
					</control>
					<include>LumenTvRowLogo</include>
					<control type="group">
						<visible>Control.HasFocus(50)</visible>
						<include content="LumenTvRowText">
							<param name="number" value="focus_text" />
							<param name="text" value="focus_text" />
							<param name="dim" value="B30B0C10" />
							<param name="track" value="260B0C10" />
							<param name="fill" value="focus_text" />
						</include>
					</control>
					<control type="group">
						<visible>!Control.HasFocus(50)</visible>
						<include content="LumenTvRowText">
							<param name="number" value="text_mute" />
							<param name="text" value="text" />
							<param name="dim" value="text_dim" />
							<param name="track" value="2EFFFFFF" />
							<param name="fill" value="accent" />
						</include>
					</control>
				</focusedlayout>
			</control>
			<!-- the focused channel's programme: picture (the logo when there is none), number and name, title, times with
			     progress, description, next; number, logo and name only without guide data -->
			<control type="grouplist">
				<left>880</left>
				<top>150</top>
				<width>976</width>
				<height>900</height>
				<orientation>vertical</orientation>
				<itemgap>14</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="group">
					<width>640</width>
					<height>360</height>
					<control type="group">
						<visible>!String.IsEmpty(ListItem.EpgEventIcon)</visible>
						<control type="image">
							<width>640</width>
							<height>360</height>
							<texture colordiffuse="card_bg" diffuse="lumen/mask_landscape.png">lumen/white.png</texture>
						</control>
						<control type="image">
							<width>640</width>
							<height>360</height>
							<aspectratio>scale</aspectratio>
							<fadetime>200</fadetime>
							<texture background="true" diffuse="lumen/mask_landscape.png">$INFO[ListItem.EpgEventIcon]</texture>
						</control>
					</control>
					<control type="group">
						<visible>String.IsEmpty(ListItem.EpgEventIcon)</visible>
						<control type="image">
							<width>640</width>
							<height>360</height>
							<texture border="20" colordiffuse="logo_tile">lumen/rr20.png</texture>
						</control>
						<control type="image">
							<left>200</left>
							<top>60</top>
							<width>240</width>
							<height>240</height>
							<aspectratio>keep</aspectratio>
							<texture background="true" fallback="lumen/icons/tv_tile.png">$INFO[ListItem.Icon]</texture>
						</control>
					</control>
				</control>
				<control type="label">
					<width>976</width>
					<height>36</height>
					<aligny>center</aligny>
					<font>lm_label_bold</font>
					<textcolor>text_dim</textcolor>
					<label>[COLOR accent]$INFO[ListItem.ChannelNumberLabel][/COLOR]$INFO[ListItem.ChannelName,   ]</label>
				</control>
				<control type="label">
					<width>976</width>
					<height>52</height>
					<aligny>center</aligny>
					<font>lm_title_s</font>
					<textcolor>text</textcolor>
					<label>$INFO[ListItem.Title]</label>
					<visible>ListItem.HasEpg</visible>
				</control>
				<control type="group">
					<width>976</width>
					<height>34</height>
					<visible>ListItem.HasEpg</visible>
					<control type="label">
						<width>190</width>
						<height>34</height>
						<aligny>center</aligny>
						<font>lm_body_s</font>
						<textcolor>text_dim</textcolor>
						<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, – ]</label>
					</control>
					<control type="image">
						<left>200</left>
						<top>13</top>
						<width>440</width>
						<height>8</height>
						<texture border="4" colordiffuse="40FFFFFF">lumen/pill_s.png</texture>
					</control>
					<control type="progress">
						<left>200</left>
						<top>13</top>
						<width>440</width>
						<height>8</height>
						<texturebg border="4" colordiffuse="00FFFFFF">lumen/pill_s.png</texturebg>
						<midtexture border="4" colordiffuse="accent">lumen/pill_s.png</midtexture>
						<info>ListItem.Progress</info>
					</control>
				</control>
				<control type="textbox">
					<width>976</width>
					<height max="156">auto</height>
					<font>lm_body</font>
					<textcolor>text_dim</textcolor>
					<label>$INFO[ListItem.Plot]</label>
					<visible>ListItem.HasEpg + !String.IsEmpty(ListItem.Plot)</visible>
				</control>
				<control type="label">
					<width>976</width>
					<height>34</height>
					<aligny>center</aligny>
					<font>lm_body_s</font>
					<textcolor>text_dim</textcolor>
					<label>[COLOR text]Next[/COLOR]  ·  $INFO[ListItem.NextStartTime]$INFO[ListItem.NextTitle,  ]</label>
					<visible>!String.IsEmpty(ListItem.NextTitle)</visible>
				</control>
			</control>
			<include>PVRChannelNumberInput</include>
		</control>
		<control type="label" id="29">
			<font></font>
			<include>HiddenObject</include>
		</control>
		<control type="label" id="30">
			<font></font>
			<include>HiddenObject</include>
		</control>
	</controls>
</window>
