<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <timer>
        <name>autoclosevideoosd</name>
        <description>Timer to auto close the video OSD (if enabled in the skin settings)</description>
        <start reset="true">Window.IsActive(videoosd) + Skin.HasSetting(OSDAutoClose) + !String.IsEqual(window(home).Property(settingslist_content),osd) + !Window.IsActive(osdsubtitlesettings) + !Window.IsActive(osdaudiosettings) + !Window.IsActive(osdvideosettings) + !Window.IsActive(OSDCMSSettings)</start>
        <reset>Window.IsActive(videoosd) + !System.IdleTime(1) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd), 1) | String.IsEqual(window(home).Property(settingslist_content),osd) | Window.IsActive(osdsubtitlesettings) | Window.IsActive(osdaudiosettings) | Window.IsActive(osdvideosettings) | Window.IsActive(OSDCMSSettings)</reset>
        <stop>!Window.IsActive(videoosd) | String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd), 4) | !String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd),Skin.Numeric(OSDAutoCloseTime))</stop>
        <onstop>Dialog.Close(videoosd)</onstop>
    </timer>
    <timer>
        <name>1109_topbaroverlay</name>
        <description>A timer that is activated when the topbaroverlay is loaded and stops automatically after 5 seconds (or playback is resumed)</description>
        <start reset="true">[Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo)] | [Window.IsActive(1109) + [Player.Seeking | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(1)]]</start>
        <reset>Player.Seeking | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(1)</reset>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(1109_topbaroverlay),5) | Player.Playing</stop>
    </timer>
    <timer>
        <name>lumenpersonplay</name>
        <description>A video started from the actor page (a title opened on it, or a poster's Play or menu): Kodi won't go full screen while a modal dialog is open, so close the actor page and the detail page below it, then go. Not the video that was already playing when the page opened</description>
        <start reset="true">Window.IsVisible(1115) + Player.HasVideo + !String.IsEqual(Player.FilenameAndPath,Window(home).Property(lumen.personbgvideo))</start>
        <onstart>ClearProperty(lumen.personreopen,home)</onstart>
        <onstart>Dialog.Close(1115,true)</onstart>
        <onstart>Dialog.Close(movieinformation,true)</onstart>
        <onstart>ActivateWindow(fullscreenvideo)</onstart>
        <stop>!Window.IsVisible(1115)</stop>
    </timer>
    <timer>
        <name>lumenkidsperson</name>
        <description>No actor page in kids mode: one open when kids mode comes on (or opened in it) closes with the detail page below it, then Home (Kodi won't change window while a modal dialog is open)</description>
        <start reset="true">Window.IsVisible(1115) + Skin.HasSetting(CinemathequeKids)</start>
        <onstart>ClearProperty(lumen.personreopen,home)</onstart>
        <onstart>Dialog.Close(1115,true)</onstart>
        <onstart>Dialog.Close(movieinformation,true)</onstart>
        <onstart>ReplaceWindow(home)</onstart>
        <stop>!Window.IsVisible(1115)</stop>
    </timer>
    <timer>
        <name>lumenkidslivetv</name>
        <description>No live TV in kids mode (nothing filters channels for children): a channel, radio station or recording started while it's on (from a phone app, say), or playing when it comes on, stops</description>
        <start reset="true">Skin.HasSetting(CinemathequeKids) + [PVR.IsPlayingTV | PVR.IsPlayingRadio | PVR.IsPlayingRecording | PVR.IsPlayingEpgTag]</start>
        <onstart>PlayerControl(Stop)</onstart>
        <stop>!PVR.IsPlayingTV + !PVR.IsPlayingRadio + !PVR.IsPlayingRecording + !PVR.IsPlayingEpgTag</stop>
    </timer>
    <timer>
        <name>lumenmoreopen</name>
        <description>A film picked in a More like this row (Custom_1116_LumenOpen.xml): once its one-film list has loaded, Info on it opens its detail page like from any grid; then the helper goes, so Back leaves the page for where it was opened from</description>
        <start reset="true">Window.IsTopMost(1116) + Integer.IsGreater(Container(5180).NumItems,0) + !Container(5180).IsUpdating</start>
        <onstart>SetFocus(5180)</onstart>
        <onstart>Action(Info)</onstart>
        <onstart>Dialog.Close(1116,true)</onstart>
        <stop>!Window.IsVisible(1116)</stop>
    </timer>
    <timer>
        <name>lumenmoreopenfail</name>
        <description>The film picked in a More like this row didn't load (gone from the library, or the database didn't answer): after 10 seconds the helper closes rather than leave its backdrop on screen</description>
        <start reset="true">Window.IsVisible(1116)</start>
        <stop>!Window.IsVisible(1116) | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(lumenmoreopenfail),10)</stop>
        <onstop>Dialog.Close(1116,true)</onstop>
    </timer>
    <timer>
        <name>lumensortdir</name>
        <description>A sort chip above a library grid (LumenSortChip) picked its sort: Kodi gives a sort the direction it last had, so once the grid is sorted, turn it the way the chip asks (newest, highest first; titles A to Z)</description>
        <start reset="true">!String.IsEmpty(Window(home).Property(lumen.sortdir))</start>
        <onstart condition="Window.IsActive(videos) + String.IsEqual(Window(home).Property(lumen.sortdir),descending) + Container.SortDirection(ascending)">Container.SetSortDirection</onstart>
        <onstart condition="Window.IsActive(videos) + String.IsEqual(Window(home).Property(lumen.sortdir),ascending) + Container.SortDirection(descending)">Container.SetSortDirection</onstart>
        <onstart>ClearProperty(lumen.sortdir,home)</onstart>
        <stop>String.IsEmpty(Window(home).Property(lumen.sortdir))</stop>
    </timer>
    <timer>
        <name>lumenhomeempty</name>
        <description>Home with no row to show (every row switched off, or the ones left on are empty; Home's control 6017 says so, as $EXP isn't expanded here): after 2 seconds of that, with nothing loading, the tab bar takes focus, or the remote would have nothing to move</description>
        <start reset="true">Window.IsActive(home) + Control.IsVisible(6017) + !ControlGroup(9000).HasFocus</start>
        <stop>!Window.IsActive(home) | !Control.IsVisible(6017) | ControlGroup(9000).HasFocus | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(lumenhomeempty),2)</stop>
        <onstop condition="Window.IsActive(home) + Control.IsVisible(6017) + !ControlGroup(9000).HasFocus + !System.HasActiveModalDialog">SetFocus(9000)</onstop>
    </timer>
    <timer>
        <name>lumenrowname</name>
        <description>Configure skin › Home rows › Add a row: once the file browser closes with a playlist picked, ask for the row's name (nothing if it was cancelled)</description>
        <start reset="true">!String.IsEmpty(Window(home).Property(lumen.rowask)) + !Window.IsVisible(filebrowser)</start>
        <onstart condition="String.IsEqual(Window(home).Property(lumen.rowask),1) + !String.IsEmpty(Skin.String(lumen.row1.path))">Skin.SetString(lumen.row1.name)</onstart>
        <onstart condition="String.IsEqual(Window(home).Property(lumen.rowask),2) + !String.IsEmpty(Skin.String(lumen.row2.path))">Skin.SetString(lumen.row2.name)</onstart>
        <onstart condition="String.IsEqual(Window(home).Property(lumen.rowask),3) + !String.IsEmpty(Skin.String(lumen.row3.path))">Skin.SetString(lumen.row3.name)</onstart>
        <onstart>ClearProperty(lumen.rowask,home)</onstart>
        <stop>String.IsEmpty(Window(home).Property(lumen.rowask))</stop>
    </timer>
    <timer>
        <name>lumensearchtype</name>
        <description>Typing on the search page (Kodi's keyboard over it): once the text has stayed the same for a second, build its search (scripts/lumen_search.py), not at every key. lumen.sq.snap holds the text when the wait began; a key stops the wait and the next frame starts another</description>
        <start reset="true">Window.IsVisible(1111) + Window.IsVisible(virtualkeyboard) + !String.IsEmpty(Control.GetLabel(312).index(1)) + [!String.IsEqual(Control.GetLabel(312).index(1),Window(home).Property(lumen.sq.text)) | [[Skin.HasSetting(CinemathequeKids) + String.IsEmpty(Window(home).Property(lumen.sq.kids))] | [!Skin.HasSetting(CinemathequeKids) + !String.IsEmpty(Window(home).Property(lumen.sq.kids))]]]</start>
        <onstart>SetProperty(lumen.sq.snap,$ESCINFO[Control.GetLabel(312).index(1)],home)</onstart>
        <stop>!Window.IsVisible(virtualkeyboard) | !String.IsEqual(Control.GetLabel(312).index(1),Window(home).Property(lumen.sq.snap)) | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(lumensearchtype),1)</stop>
        <onstop condition="Window.IsVisible(virtualkeyboard) + String.IsEqual(Control.GetLabel(312).index(1),Window(home).Property(lumen.sq.snap)) + [!String.IsEqual(Control.GetLabel(312).index(1),Window(home).Property(lumen.sq.text)) | [[Skin.HasSetting(CinemathequeKids) + String.IsEmpty(Window(home).Property(lumen.sq.kids))] | [!Skin.HasSetting(CinemathequeKids) + !String.IsEmpty(Window(home).Property(lumen.sq.kids))]]]">RunScript(special://skin/scripts/lumen_search.py,typed)</onstop>
    </timer>
    <timer>
        <name>lumensearchrun</name>
        <description>The search page with its search confirmed (keyboard closed), or kids mode switched over it: build the search if what was last built is for another text or mode. Again every 3 seconds if the script didn't answer</description>
        <start reset="true">Window.IsActive(1111) + !Window.IsVisible(virtualkeyboard) + !String.IsEmpty(Skin.String(lumen.search)) + [!String.IsEqual(Skin.String(lumen.search),Window(home).Property(lumen.sq.text)) | [[Skin.HasSetting(CinemathequeKids) + String.IsEmpty(Window(home).Property(lumen.sq.kids))] | [!Skin.HasSetting(CinemathequeKids) + !String.IsEmpty(Window(home).Property(lumen.sq.kids))]]]</start>
        <onstart>RunScript(special://skin/scripts/lumen_search.py,search)</onstart>
        <stop>!Window.IsActive(1111) | Window.IsVisible(virtualkeyboard) | [String.IsEqual(Skin.String(lumen.search),Window(home).Property(lumen.sq.text)) + ![[[Skin.HasSetting(CinemathequeKids) + String.IsEmpty(Window(home).Property(lumen.sq.kids))] | [!Skin.HasSetting(CinemathequeKids) + !String.IsEmpty(Window(home).Property(lumen.sq.kids))]]]] | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(lumensearchrun),3)</stop>
    </timer>
    <timer>
        <name>lumensearchmode</name>
        <description>Kids mode switched while the search page is open (only from outside, as the kids button is on Home): back to Home, as entering kids mode does, so the page never shows a search made in the other mode (its lists keep their items until new ones load)</description>
        <start reset="true">Window.IsActive(1111) + [[Skin.HasSetting(CinemathequeKids) + String.IsEmpty(Window(home).Property(lumen.searchkids))] | [!Skin.HasSetting(CinemathequeKids) + !String.IsEmpty(Window(home).Property(lumen.searchkids))]]</start>
        <onstart>Dialog.Close(all,true)</onstart>
        <onstart>ReplaceWindow(home)</onstart>
        <stop>!Window.IsActive(1111)</stop>
    </timer>
</timers>
