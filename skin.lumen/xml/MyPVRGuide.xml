<?xml version="1.0" encoding="UTF-8"?>
<!-- Live TV guide: every channel (Lumen opens it on lumen.tv.all; there is no group selector), channels down, three hours
     across, an orange line at the current time. The header shows the selected programme. Chips: Now, then one per group
     jumping to its first channel. ↑ on the first row or Back goes up to the chips; Back there leaves. OK on a programme
     on now plays its channel, on a later one shows its info (epg.selectaction smart select). Not for kids. -->
<window>
	<onload condition="$EXP[LumenKids]">ReplaceWindow(home)</onload>
	<onload condition="!PVR.IsPlayingTV">PVR.EpgGridControl(firstchannel)</onload>
	<defaultcontrol always="true">50</defaultcontrol>
	<!-- a plain dark backdrop: the usual fanart backdrop reloads with every move (slow on the Pi) -->
	<backgroundcolor>FF0A0D13</backgroundcolor>
	<views>50</views>
	<controls>
		<!-- Kodi's channel group selector. Lumen has none, but Kodi keeps a pointer to the one it found last: after a skin
		     reload or a skin switch it would point at a freed control and crash the window's first opening -->
		<control type="list" id="11">
			<width>1</width>
			<height>1</height>
			<itemlayout width="1" height="1" />
			<focusedlayout width="1" height="1" />
			<visible>false</visible>
		</control>
		<control type="group">
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
			<include>LumenFadeInWindow</include>
			<control type="label">
				<left>64</left>
				<top>44</top>
				<width>900</width>
				<height>62</height>
				<aligny>center</aligny>
				<font>lm_title</font>
				<textcolor>text</textcolor>
				<label>TV guide</label>
			</control>
			<include>LumenClock</include>
			<!-- the selected programme -->
			<control type="grouplist">
				<left>64</left>
				<top>132</top>
				<width>1240</width>
				<height>230</height>
				<orientation>vertical</orientation>
				<itemgap>10</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label" id="1301">
					<width>1240</width>
					<height>48</height>
					<aligny>center</aligny>
					<font>lm_title_s</font>
					<textcolor>text</textcolor>
					<label>$INFO[ListItem.Title]</label>
				</control>
				<control type="label">
					<width>1240</width>
					<height>30</height>
					<aligny>center</aligny>
					<font>lm_body_s</font>
					<textcolor>text_dim</textcolor>
					<label>$INFO[ListItem.ChannelNumberLabel,,  ·  ]$INFO[ListItem.ChannelName,,  ·  ]$VAR[LumenTvWhen]$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, – ]$INFO[ListItem.Genre,  ·  ]</label>
				</control>
				<control type="textbox">
					<width>1240</width>
					<height>74</height>
					<font>lm_body</font>
					<textcolor>text_dim</textcolor>
					<label>$INFO[ListItem.Plot]</label>
				</control>
			</control>
			<control type="group">
				<right>80</right>
				<top>120</top>
				<width>400</width>
				<height>225</height>
				<control type="group">
					<visible>!String.IsEmpty(ListItem.EpgEventIcon)</visible>
					<control type="image">
						<texture colordiffuse="card_bg" diffuse="lumen/mask_landscape.png">lumen/white.png</texture>
					</control>
					<control type="image">
						<aspectratio>scale</aspectratio>
						<fadetime>200</fadetime>
						<texture background="true" diffuse="lumen/mask_landscape.png">$INFO[ListItem.EpgEventIcon]</texture>
					</control>
				</control>
				<control type="group">
					<visible>String.IsEmpty(ListItem.EpgEventIcon) + !String.IsEmpty(ListItem.ChannelName)</visible>
					<control type="image">
						<texture border="20" colordiffuse="logo_tile">lumen/rr20.png</texture>
					</control>
					<control type="image">
						<left>120</left>
						<top>32</top>
						<width>160</width>
						<height>160</height>
						<aspectratio>keep</aspectratio>
						<texture background="true" fallback="lumen/icons/tv_tile.png">$INFO[ListItem.Icon]</texture>
					</control>
				</control>
			</control>
			<!-- the groups' own lists, for the chips -->
			<control type="group">
				<include content="LumenNextLookup">
					<param name="id" value="9311" />
					<param name="path" value="pvr://channels/tv/" />
				</include>
				<include content="LumenNextLookup">
					<param name="id" value="9337" />
					<param name="path" value="$INFO[Window(home).Property(lumen.tv.all)]" />
				</include>
				<include content="LumenTvGroupLookup"><param name="group" value="0" /><param name="lookup" value="9321" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="1" /><param name="lookup" value="9322" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="2" /><param name="lookup" value="9323" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="3" /><param name="lookup" value="9324" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="4" /><param name="lookup" value="9325" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="5" /><param name="lookup" value="9326" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="6" /><param name="lookup" value="9327" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="7" /><param name="lookup" value="9328" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="8" /><param name="lookup" value="9329" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="9" /><param name="lookup" value="9330" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="10" /><param name="lookup" value="9331" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="11" /><param name="lookup" value="9332" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="12" /><param name="lookup" value="9333" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="13" /><param name="lookup" value="9334" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="14" /><param name="lookup" value="9335" /></include>
				<include content="LumenTvGroupLookup"><param name="group" value="15" /><param name="lookup" value="9336" /></include>
			</control>
			<control type="grouplist" id="70">
				<left>64</left>
				<top>384</top>
				<width>1788</width>
				<height>48</height>
				<orientation>horizontal</orientation>
				<itemgap>12</itemgap>
				<ondown>50</ondown>
				<include content="LumenChip">
					<param name="id" value="87" />
					<param name="label" value="Now" />
					<param name="selected" value="false" />
					<param name="onclick_condition" value="true" />
					<param name="onclick" value="PVR.EpgGridControl(currentprogramme)" />
					<param name="onclick2_condition" value="true" />
					<param name="onclick2" value="SetFocus(50)" />
				</include>
				<include content="LumenTvGuideChip"><param name="id" value="71" /><param name="group" value="0" /><param name="lookup" value="9321" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="72" /><param name="group" value="1" /><param name="lookup" value="9322" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="73" /><param name="group" value="2" /><param name="lookup" value="9323" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="74" /><param name="group" value="3" /><param name="lookup" value="9324" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="75" /><param name="group" value="4" /><param name="lookup" value="9325" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="76" /><param name="group" value="5" /><param name="lookup" value="9326" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="77" /><param name="group" value="6" /><param name="lookup" value="9327" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="78" /><param name="group" value="7" /><param name="lookup" value="9328" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="79" /><param name="group" value="8" /><param name="lookup" value="9329" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="80" /><param name="group" value="9" /><param name="lookup" value="9330" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="81" /><param name="group" value="10" /><param name="lookup" value="9331" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="82" /><param name="group" value="11" /><param name="lookup" value="9332" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="83" /><param name="group" value="12" /><param name="lookup" value="9333" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="84" /><param name="group" value="13" /><param name="lookup" value="9334" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="85" /><param name="group" value="14" /><param name="lookup" value="9335" /></include>
				<include content="LumenTvGuideChip"><param name="id" value="86" /><param name="group" value="15" /><param name="lookup" value="9336" /></include>
			</control>
			<control type="epggrid" id="50">
				<left>64</left>
				<top>470</top>
				<width>1788</width>
				<height>578</height>
				<orientation>vertical</orientation>
				<scrolltime tween="quadratic" easing="out">240</scrolltime>
				<timeblocks>36</timeblocks>
				<rulerunit>6</rulerunit>
				<onup>70</onup>
				<onback>70</onback>
				<viewtype label="19298">list</viewtype>
				<progresstexture border="0,0,3,0" colordiffuse="accent">lumen/now_line.png</progresstexture>
				<rulerdatelayout width="348" height="46">
					<control type="label">
						<left>16</left>
						<width>320</width>
						<height>46</height>
						<aligny>center</aligny>
						<font>lm_caption_bold</font>
						<textcolor>text_dim</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</rulerdatelayout>
				<rulerlayout height="46" width="240">
					<control type="label">
						<left>8</left>
						<width>232</width>
						<height>46</height>
						<aligny>center</aligny>
						<font>lm_caption</font>
						<textcolor>text_dim</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</rulerlayout>
				<channellayout height="76" width="348">
					<include content="LumenTvGuideChannel">
						<param name="bg" value="0FFFFFFF" />
						<param name="name" value="text_dim" />
					</include>
				</channellayout>
				<focusedchannellayout height="76" width="348">
					<include content="LumenTvGuideChannel">
						<param name="bg" value="1FFFFFFF" />
						<param name="name" value="text" />
					</include>
				</focusedchannellayout>
				<!-- 39 wide, under a one-block cell (40): Kodi stretches a cell's layout only when the widths differ, and that also
				     hides the labels (id 1) of cells too narrow for text -->
				<itemlayout height="76" width="39">
					<control type="image" id="2">
						<width>33</width>
						<height>70</height>
						<texture border="14" colordiffuse="17FFFFFF">lumen/rr14.png</texture>
					</control>
					<control type="label" id="1">
						<left>16</left>
						<top>10</top>
						<width>1</width>
						<height>28</height>
						<aligny>center</aligny>
						<font>lm_caption_bold</font>
						<textcolor>text</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<!-- id 1 as well: Kodi hides it with the title on a cell too narrow for text -->
					<control type="label" id="1">
						<left>16</left>
						<top>38</top>
						<width>1</width>
						<height>24</height>
						<aligny>center</aligny>
						<font>lm_micro</font>
						<textcolor>text_dim</textcolor>
						<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, – ]</label>
					</control>
				</itemlayout>
				<focusedlayout height="76" width="39">
					<control type="image" id="2">
						<width>33</width>
						<height>70</height>
						<texture border="14" colordiffuse="FFFFFFFF">lumen/rr14.png</texture>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="image" id="3">
						<width>33</width>
						<height>70</height>
						<texture border="14" colordiffuse="2EFFFFFF">lumen/rr14.png</texture>
						<visible>!Control.HasFocus(50)</visible>
					</control>
					<control type="label" id="1">
						<left>16</left>
						<top>10</top>
						<width>1</width>
						<height>28</height>
						<aligny>center</aligny>
						<font>lm_caption_bold</font>
						<textcolor>$VAR[LumenTvGuideCellText]</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label" id="1">
						<left>16</left>
						<top>38</top>
						<width>1</width>
						<height>24</height>
						<aligny>center</aligny>
						<font>lm_micro</font>
						<textcolor>$VAR[LumenTvGuideCellDim]</textcolor>
						<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, – ]</label>
					</control>
				</focusedlayout>
			</control>
			<include>PVRChannelNumberInput</include>
		</control>
	</controls>
</window>
