			<scrolltime tween="cubic" easing="out">360</scrolltime>
			<viewtype label="Showcase">wrap</viewtype>
			<visible>Container.Content(seasons) | [Container.Content(movies) + String.StartsWith(Container.FolderPath,videodb://movies/sets/)]</visible>
