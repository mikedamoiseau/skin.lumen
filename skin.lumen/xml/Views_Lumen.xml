		<!-- next episode, the phone app's rule (season 0 ignored): the last played one if unfinished, else the
		     next unwatched after it; nothing played: the first unwatched; all watched: the first episode -->
		<control type="group">
			<visible>[Control.IsVisible(501) | Control.IsVisible(502)] + $EXP[LumenShowPage]</visible>
