<?xml version="1.0" encoding="UTF-8"?>
<!-- Lumen library views (used by MyVideoNav). -->
<includes>
	<variable name="LumenLibraryTitle">
		<value condition="Container.Content(movies) + String.StartsWith(Container.FolderPath,videodb://movies/sets/)">$INFO[Container.FolderName]</value>
		<value condition="Container.Content(movies)">$LOCALIZE[342]</value>
		<value condition="Container.Content(tvshows)">$LOCALIZE[20343]</value>
		<value condition="Container.Content(sets)">Collections</value>
		<value condition="Container.Content(seasons) | Container.Content(episodes)">$INFO[Container.ShowTitle]</value>
		<value condition="!String.IsEmpty(Container.PluginName)">$INFO[Container.FolderName]</value>
		<value>$INFO[Container.FolderName]</value>
	</variable>
	<variable name="LumenLibraryFanart">
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(fanart))">$INFO[Container.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
	</variable>
	<variable name="LumenListThumb">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="LumenEpisodeTitle">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Episode,,.  ]$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="LumenEpisodeSub">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEqual(ListItem.Duration(h),0)">$INFO[ListItem.Duration(h),,h ]$INFO[ListItem.Duration(m),,m]$INFO[ListItem.Premiered,  ·  ]</value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Duration(m),,m]$INFO[ListItem.Premiered,  ·  ]</value>
		<value>$INFO[ListItem.Label2]</value>
	</variable>

	<!-- show page (seasons of a show, or a show's episodes) -->
	<expression name="LumenShowPage">Container.Content(seasons) | [Container.Content(episodes) + [String.StartsWith(Container.FolderPath,videodb://tvshows/titles/) | String.StartsWith(Container.FolderPath,videodb://inprogresstvshows/)]]</expression>
	<expression name="LumenNextLastPlayed">Integer.IsGreater(Container(5110).NumItems,0) + String.IsEqual(Container(5110).ListItem.TvShowDBID,ListItem.TvShowDBID) + [Container(5110).ListItem.IsResumable | !Integer.IsGreater(Container(5110).ListItem.PlayCount,0)]</expression>
	<expression name="LumenNextAfterLast">Integer.IsGreater(Container(5110).NumItems,0) + String.IsEqual(Container(5110).ListItem.TvShowDBID,ListItem.TvShowDBID) + !$EXP[LumenNextLastPlayed] + Integer.IsGreater(Container(5111).NumItems,0) + String.IsEqual(Container(5111).ListItem.TvShowDBID,ListItem.TvShowDBID)</expression>
	<expression name="LumenNextFirstUnwatched">![Integer.IsGreater(Container(5110).NumItems,0) + String.IsEqual(Container(5110).ListItem.TvShowDBID,ListItem.TvShowDBID)] + Integer.IsGreater(Container(5112).NumItems,0) + String.IsEqual(Container(5112).ListItem.TvShowDBID,ListItem.TvShowDBID)</expression>
	<expression name="LumenNextWatchAgain">!$EXP[LumenNextLastPlayed] + !$EXP[LumenNextAfterLast] + !$EXP[LumenNextFirstUnwatched] + Integer.IsGreater(Container(5113).NumItems,0) + String.IsEqual(Container(5113).ListItem.TvShowDBID,ListItem.TvShowDBID)</expression>
	<!-- no show id (an empty show, or not a show page) = no path; "titles//-1/" would list every episode -->
	<variable name="LumenLastPlayedPath">
		<value condition="!String.IsEmpty(ListItem.TvShowDBID)">videodb://tvshows/titles/$INFO[ListItem.TvShowDBID]/-1/?xsp=%7B%22type%22%3A%22episodes%22%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22season%22%2C%22operator%22%3A%22greaterthan%22%2C%22value%22%3A%5B%220%22%5D%7D%2C%7B%22field%22%3A%22lastplayed%22%2C%22operator%22%3A%22after%22%2C%22value%22%3A%5B%221900-01-01%22%5D%7D%5D%7D%2C%22order%22%3A%7B%22method%22%3A%22lastplayed%22%2C%22direction%22%3A%22descending%22%7D%2C%22limit%22%3A1%7D</value>
	</variable>
	<variable name="LumenAfterLastPath">
		<value condition="!String.IsEmpty(ListItem.TvShowDBID)">videodb://tvshows/titles/$INFO[ListItem.TvShowDBID]/-1/?xsp=%7B%22type%22%3A%22episodes%22%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22season%22%2C%22operator%22%3A%22greaterthan%22%2C%22value%22%3A%5B%220%22%5D%7D%2C%7B%22field%22%3A%22playcount%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%220%22%5D%7D%2C%7B%22or%22%3A%5B%7B%22field%22%3A%22season%22%2C%22operator%22%3A%22greaterthan%22%2C%22value%22%3A%5B%22$INFO[Container(5110).ListItem.Season]%22%5D%7D%2C%7B%22and%22%3A%5B%7B%22field%22%3A%22season%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(5110).ListItem.Season]%22%5D%7D%2C%7B%22field%22%3A%22episode%22%2C%22operator%22%3A%22greaterthan%22%2C%22value%22%3A%5B%22$INFO[Container(5110).ListItem.Episode]%22%5D%7D%5D%7D%5D%7D%5D%7D%2C%22order%22%3A%7B%22method%22%3A%22episode%22%2C%22direction%22%3A%22ascending%22%7D%2C%22limit%22%3A1%7D</value>
	</variable>
	<variable name="LumenFirstUnwatchedPath">
		<value condition="!String.IsEmpty(ListItem.TvShowDBID)">videodb://tvshows/titles/$INFO[ListItem.TvShowDBID]/-1/?xsp=%7B%22type%22%3A%22episodes%22%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22season%22%2C%22operator%22%3A%22greaterthan%22%2C%22value%22%3A%5B%220%22%5D%7D%2C%7B%22field%22%3A%22playcount%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%220%22%5D%7D%5D%7D%2C%22order%22%3A%7B%22method%22%3A%22episode%22%2C%22direction%22%3A%22ascending%22%7D%2C%22limit%22%3A1%7D</value>
	</variable>
	<variable name="LumenFirstEpisodePath">
		<value condition="!String.IsEmpty(ListItem.TvShowDBID)">videodb://tvshows/titles/$INFO[ListItem.TvShowDBID]/-1/?xsp=%7B%22type%22%3A%22episodes%22%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22season%22%2C%22operator%22%3A%22greaterthan%22%2C%22value%22%3A%5B%220%22%5D%7D%5D%7D%2C%22order%22%3A%7B%22method%22%3A%22episode%22%2C%22direction%22%3A%22ascending%22%7D%2C%22limit%22%3A1%7D</value>
	</variable>
	<variable name="LumenNextLabel">
		<value condition="$EXP[LumenNextLastPlayed] + Container(5110).ListItem.IsResumable">Resume S$INFO[Container(5110).ListItem.Season] E$INFO[Container(5110).ListItem.Episode]</value>
		<value condition="$EXP[LumenNextLastPlayed]">Play S$INFO[Container(5110).ListItem.Season] E$INFO[Container(5110).ListItem.Episode]</value>
		<value condition="$EXP[LumenNextAfterLast]">Play S$INFO[Container(5111).ListItem.Season] E$INFO[Container(5111).ListItem.Episode]</value>
		<value condition="$EXP[LumenNextFirstUnwatched]">Play S$INFO[Container(5112).ListItem.Season] E$INFO[Container(5112).ListItem.Episode]</value>
		<value condition="$EXP[LumenNextWatchAgain]">Watch again</value>
		<value condition="!Container(5113).IsUpdating">No episodes</value>
		<value>$LOCALIZE[208]</value>
	</variable>
	<variable name="LumenNextCaption">
		<value condition="$EXP[LumenNextLastPlayed]">$INFO[Container(5110).ListItem.Title]</value>
		<value condition="$EXP[LumenNextAfterLast]">$INFO[Container(5111).ListItem.Title]</value>
		<value condition="$EXP[LumenNextFirstUnwatched]">$INFO[Container(5112).ListItem.Title]</value>
		<value condition="$EXP[LumenNextWatchAgain]">You're all caught up · S$INFO[Container(5113).ListItem.Season] E$INFO[Container(5113).ListItem.Episode]  $INFO[Container(5113).ListItem.Title]</value>
	</variable>

	<!-- Header used by the grid / list views -->
	<include name="LumenLibraryHeader">
		<control type="group">
			<include>LumenFadeInWindow</include>
			<control type="label">
				<left>lm_margin</left>
				<top>52</top>
				<width>1100</width>
				<height>66</height>
				<font>lm_title</font>
				<textcolor>text</textcolor>
				<label>$VAR[LumenLibraryTitle]</label>
			</control>
			<control type="label">
				<left>lm_margin</left>
				<top>118</top>
				<width>1100</width>
				<height>36</height>
				<font>lm_caption</font>
				<textcolor>text_mute</textcolor>
				<label>$INFO[Container.NumItems,, items]$INFO[Container.SortMethod,  ·  $LOCALIZE[31022] ]</label>
				<visible>!$EXP[LumenQuickFilters]</visible>
			</control>
			<include>LumenQuickFilterBar</include>
			<control type="group">
				<left>720</left>
				<top>112</top>
				<width>1120</width>
				<visible>[!ListItem.IsFolder | ListItem.IsCollection | String.IsEqual(ListItem.DBType,tvshow)] + !$EXP[LumenQuickFilters]</visible>
				<include content="LumenMetaLine">
					<param name="item" value="ListItem" />
					<param name="align" value="right" />
					<param name="width" value="1120" />
				</include>
			</control>
			<!-- over a chip row the line moves up beside the title ("Movies" or "TV shows"), short of the clock -->
			<control type="group">
				<left>640</left>
				<top>68</top>
				<width>1000</width>
				<visible>[!ListItem.IsFolder | ListItem.IsCollection | String.IsEqual(ListItem.DBType,tvshow)] + $EXP[LumenQuickFilters]</visible>
				<include content="LumenMetaLine">
					<param name="item" value="ListItem" />
					<param name="align" value="right" />
					<param name="width" value="1000" />
				</include>
			</control>
		</control>
		<include>LumenClock</include>
	</include>

	<!-- Quick filters: a chip row above a film or show grid (not a collection's films, not recently added, whose
	     sorts differ). The chips use Kodi's own watched filter and sort, so the side menu agrees with them.
	     The watched filter is the window's button 14: All <-> Unwatched, and from the side menu's Watched mode, All. -->
	<expression name="LumenQuickFilters">[Container.Content(movies) | Container.Content(tvshows)] + [[String.StartsWith(Container.FolderPath,videodb://movies/) + !String.StartsWith(Container.FolderPath,videodb://movies/sets/)] | String.StartsWith(Container.FolderPath,videodb://tvshows/) | String.EndsWith(Container.FolderPath,.xsp)] + !Control.IsVisible(501) + !Control.IsVisible(502)</expression>
	<!-- Kodi labels the side menu's watched button with the mode; 6219 holds the label for All -->
	<expression name="LumenWatchAll">String.IsEqual(Control.GetLabel(10),Control.GetLabel(6219))</expression>
	<!-- an empty grid that a watched filter emptied (the chip's Unwatched, or the side menu's Watched mode): say so,
	     and keep focus off Kodi's ".." item (as in kids mode). Kodi keeps the filter per device, kids grids included -->
	<expression name="LumenFilteredEmpty">!$EXP[LumenWatchAll] + $EXP[LumenQuickFilters] + !Integer.IsGreater(Container.NumItems,0)</expression>
	<variable name="LumenEmptyGridText">
		<value condition="System.Setting(hidewatched)">Nothing unwatched here.</value>
		<value condition="$EXP[LumenFilteredEmpty]">Nothing watched here.</value>
		<value>Nothing here yet. A parent can choose titles in the Cinémathèque app.</value>
	</variable>
	<variable name="LumenSortArrow29">
		<value condition="Container.SortMethod(29) + Container.SortDirection(descending)">  ↓</value>
		<value condition="Container.SortMethod(29)">  ↑</value>
	</variable>
	<variable name="LumenSortArrow40">
		<value condition="Container.SortMethod(40) + Container.SortDirection(descending)">  ↓</value>
		<value condition="Container.SortMethod(40)">  ↑</value>
	</variable>
	<variable name="LumenSortArrow16">
		<value condition="Container.SortMethod(16) + Container.SortDirection(descending)">  ↓</value>
		<value condition="Container.SortMethod(16)">  ↑</value>
	</variable>
	<variable name="LumenSortArrow17">
		<value condition="Container.SortMethod(17) + Container.SortDirection(descending)">  ↓</value>
		<value condition="Container.SortMethod(17)">  ↑</value>
	</variable>
	<include name="LumenChip">
		<param name="onclick2_condition">false</param>
		<param name="onclick2">noop</param>
		<param name="onclick3_condition">false</param>
		<param name="onclick3">noop</param>
		<definition>
			<!-- label and altlabel alike: the row lays chips out by the label's width -->
			<control type="togglebutton" id="$PARAM[id]">
				<width>auto</width>
				<height>48</height>
				<font>lm_caption_bold</font>
				<textoffsetx>22</textoffsetx>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>text</textcolor>
				<focusedcolor>focus_text</focusedcolor>
				<label>$PARAM[label]</label>
				<altlabel>$PARAM[label]</altlabel>
				<texturefocus border="24" colordiffuse="FFFFFFFF">lumen/pill.png</texturefocus>
				<texturenofocus border="24" colordiffuse="14FFFFFF">lumen/pill.png</texturenofocus>
				<alttexturefocus border="24" colordiffuse="FFFFFFFF">lumen/pill.png</alttexturefocus>
				<alttexturenofocus border="24" colordiffuse="4DFFFFFF">lumen/pill.png</alttexturenofocus>
				<usealttexture>$PARAM[selected]</usealttexture>
				<onclick condition="$PARAM[onclick_condition]">$PARAM[onclick]</onclick>
				<onclick condition="$PARAM[onclick2_condition]">$PARAM[onclick2]</onclick>
				<onclick condition="$PARAM[onclick3_condition]">$PARAM[onclick3]</onclick>
			</control>
		</definition>
	</include>
	<!-- a sort chip: picks its sort; Kodi then gives it the direction it last had, so it also asks for its own
	     (lumensortdir in Timers.xml turns it once the list is sorted); pressed again, it turns the order round -->
	<include name="LumenSortChip">
		<definition>
			<include content="LumenChip">
				<param name="id" value="$PARAM[id]" />
				<param name="label" value="$PARAM[label]$VAR[LumenSortArrow$PARAM[sort]]" />
				<param name="selected" value="Container.SortMethod($PARAM[sort])" />
				<param name="onclick_condition" value="Container.SortMethod($PARAM[sort])" />
				<param name="onclick" value="Container.SetSortDirection" />
				<param name="onclick2_condition" value="!Container.SortMethod($PARAM[sort])" />
				<param name="onclick2" value="Container.SetSortMethod($PARAM[sort])" />
				<param name="onclick3_condition" value="!Container.SortMethod($PARAM[sort])" />
				<param name="onclick3" value="SetProperty(lumen.sortdir,$PARAM[direction],home)" />
			</include>
		</definition>
	</include>
	<include name="LumenQuickFilterBar">
		<control type="label" id="6219">
			<visible>false</visible>
			<label>$LOCALIZE[16100]</label>
		</control>
		<control type="grouplist" id="6210">
			<left>lm_margin</left>
			<top>126</top>
			<width>1100</width>
			<height>48</height>
			<orientation>horizontal</orientation>
			<itemgap>10</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<visible>$EXP[LumenQuickFilters] + [Integer.IsGreater(Container.NumItems,0) | !$EXP[LumenWatchAll]]</visible>
			<onleft>9000</onleft>
			<onright>noop</onright>
			<onup>noop</onup>
			<!-- the first id whose condition holds wins. Empty grid first: its view sits in a hidden group but still
			     counts as visible. Ids, not SetFocus: a SetFocus doesn't count as handling Back, so the window would close too -->
			<ondown condition="$EXP[LumenFilteredEmpty]">6061</ondown>
			<ondown condition="Control.IsVisible(500)">500</ondown>
			<ondown condition="Control.IsVisible(503)">503</ondown>
			<ondown condition="Control.IsVisible(50)">50</ondown>
			<onback condition="$EXP[LumenFilteredEmpty]">6061</onback>
			<onback condition="Control.IsVisible(500)">500</onback>
			<onback condition="Control.IsVisible(503)">503</onback>
			<onback condition="Control.IsVisible(50)">50</onback>
			<include content="LumenChip">
				<param name="id" value="6211" />
				<param name="label" value="$LOCALIZE[593]" />
				<param name="selected" value="$EXP[LumenWatchAll]" />
				<param name="onclick_condition" value="!$EXP[LumenWatchAll]" />
				<param name="onclick" value="SendClick(14)" />
			</include>
			<!-- from Watched, the first click lands on All -->
			<include content="LumenChip">
				<param name="id" value="6212" />
				<param name="label" value="$LOCALIZE[16101]" />
				<param name="selected" value="System.Setting(hidewatched)" />
				<param name="onclick_condition" value="!System.Setting(hidewatched)" />
				<param name="onclick" value="SendClick(14)" />
				<param name="onclick2_condition" value="!System.Setting(hidewatched) + !$EXP[LumenWatchAll]" />
				<param name="onclick2" value="SendClick(14)" />
			</include>
			<!-- a gap between the watched and sort chips; an id keeps the row's left/right chain going -->
			<control type="image" id="6218">
				<width>24</width>
				<height>48</height>
				<texture />
			</control>
			<include content="LumenSortChip">
				<param name="id" value="6213" />
				<param name="label" value="$LOCALIZE[369]" />
				<param name="sort" value="29" />
				<param name="direction" value="ascending" />
			</include>
			<include content="LumenSortChip">
				<param name="id" value="6214" />
				<param name="label" value="$LOCALIZE[570]" />
				<param name="sort" value="40" />
				<param name="direction" value="descending" />
			</include>
			<include content="LumenSortChip">
				<param name="id" value="6215" />
				<param name="label" value="$LOCALIZE[562]" />
				<param name="sort" value="16" />
				<param name="direction" value="descending" />
			</include>
			<include content="LumenSortChip">
				<param name="id" value="6216" />
				<param name="label" value="$LOCALIZE[563]" />
				<param name="sort" value="17" />
				<param name="direction" value="descending" />
			</include>
			<control type="label">
				<width>auto</width>
				<height>48</height>
				<aligny>center</aligny>
				<font>lm_caption</font>
				<textcolor>text_mute</textcolor>
				<label>$INFO[Container.NumItems,     , items]</label>
			</control>
		</control>
	</include>

	<!-- 500: poster grid -->
	<include name="View_Lumen_Posters">
		<control type="panel" id="500">
			<include>LumenKidsEmptyFocus</include>
			<left>80</left>
			<top>170</top>
			<width>1760</width>
			<height>910</height>
			<onleft>9000</onleft>
			<onright>noop</onright>
			<onup condition="Control.IsVisible(6210)">6210</onup>
			<onup condition="!Control.IsVisible(6210)">noop</onup>
			<ondown>noop</ondown>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">380</scrolltime>
			<preloaditems>0</preloaditems>
			<viewtype label="Posters">icon</viewtype>
			<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(actors) | Container.Content(directors)</visible>
			<include>LumenRiseIn</include>
			<itemlayout width="246" height="420">
				<control type="group">
					<left>30</left>
					<top>26</top>
					<include>LumenPosterCard</include>
				</control>
			</itemlayout>
			<focusedlayout width="246" height="420">
				<control type="group">
					<left>30</left>
					<top>26</top>
					<include content="LumenCardFocus">
						<param name="cx" value="105" />
						<param name="cy" value="157" />
					</include>
					<include content="LumenPosterCard">
						<param name="focused" value="Control.HasFocus(500)" />
					</include>
				</control>
				<control type="label">
					<left>10</left>
					<top>364</top>
					<width>250</width>
					<height>40</height>
					<align>center</align>
					<font>lm_label_bold</font>
					<textcolor>text</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(500)</visible>
				</control>
			</focusedlayout>
		</control>
	</include>

	<!-- a hidden 1x1 list used as a lookup -->
	<include name="LumenNextLookup">
		<!-- limit 0: everything; a limited lookup gets no "more" item (browse never) -->
		<param name="limit">0</param>
		<definition>
			<control type="list" id="$PARAM[id]">
				<left>-20</left>
				<top>-20</top>
				<width>1</width>
				<height>1</height>
				<itemlayout width="1" height="1" />
				<focusedlayout width="1" height="1" />
				<content target="videos" limit="$PARAM[limit]" browse="never">$PARAM[path]</content>
			</control>
		</definition>
	</include>

	<!-- 501 / 502: showcase — hero for the focused item + one row; a show page adds Play, season tabs, episodes -->
	<include name="View_Lumen_Showcase">
		<control type="group">
			<visible>[Control.IsVisible(501) | Control.IsVisible(502)] + !$EXP[LumenShowPage]</visible>
			<include content="LumenHero">
				<param name="item" value="ListItem" />
				<param name="top" value="150" />
			</include>
		</control>
		<control type="group">
			<visible>[Control.IsVisible(501) | Control.IsVisible(502)] + $EXP[LumenShowPage]</visible>
			<include content="LumenHero">
				<param name="item" value="ListItem" />
				<param name="top" value="96" />
			</include>
		</control>
		<control type="list" id="501">
			<include>LumenKidsEmptyFocus</include>
			<left>80</left>
			<top>644</top>
			<width>1840</width>
			<height>420</height>
			<onleft>9000</onleft>
			<onright>noop</onright>
			<onup condition="Container.Content(seasons)">5101</onup>
			<onup condition="!Container.Content(seasons)">noop</onup>
			<ondown condition="Container.Content(seasons)">5102</ondown>
