			<!-- seasons: text tabs -->
			<itemlayout width="230" height="64" condition="Container.Content(seasons)">
				<control type="label">
					<left>10</left>
					<top>2</top>
					<width>210</width>
					<height>60</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>lm_tab</font>
					<textcolor>text_dim</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="230" height="64" condition="Container.Content(seasons)">
				<control type="group">
					<animation effect="zoom" start="100" end="106" center="115,32" time="200" tween="cubic" easing="out" reversible="false">Focus</animation>
					<animation effect="zoom" start="106" end="100" center="115,32" time="200" tween="cubic" easing="out" reversible="false">UnFocus</animation>
					<control type="image">
						<left>10</left>
						<top>2</top>
						<width>210</width>
						<height>60</height>
						<texture border="30" colordiffuse="FFFFFFFF">lumen/pill.png</texture>
						<visible>Control.HasFocus(501)</visible>
					</control>
					<control type="image">
						<left>10</left>
						<top>2</top>
						<width>210</width>
						<height>60</height>
						<texture border="30" colordiffuse="24FFFFFF">lumen/pill.png</texture>
						<visible>!Control.HasFocus(501)</visible>
					</control>
					<control type="label">
						<left>10</left>
						<top>2</top>
						<width>210</width>
						<height>60</height>
						<align>center</align>
						<aligny>center</aligny>
						<font>lm_tab</font>
						<textcolor>focus_text</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>Control.HasFocus(501)</visible>
					</control>
					<control type="label">
						<left>10</left>
						<top>2</top>
						<width>210</width>
						<height>60</height>
						<align>center</align>
						<aligny>center</aligny>
						<font>lm_tab</font>
						<textcolor>text</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(501)</visible>
					</control>
				</control>
			</focusedlayout>
			<!-- movies in a collection: posters -->
			<itemlayout width="240" height="420">
