		<!-- show page: "Play S2 E5" -->
		<control type="group">
			<left>lm_margin</left>
			<top>516</top>
			<visible>[Control.IsVisible(501) | Control.IsVisible(502)] + $EXP[LumenShowPage] + Integer.IsGreater(Container.NumItems,0)</visible>
