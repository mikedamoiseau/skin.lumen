					<top>352</top>
					<width>250</width>
					<height>40</height>
					<align>center</align>
					<font>lm_label_bold</font>
					<textcolor>text</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(501)</visible>
				</control>
			</focusedlayout>
		</control>
		<!-- episodes of the season under the tabs; selecting one plays it (resuming if started) -->
