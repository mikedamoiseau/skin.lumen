				<texturenofocus border="32" colordiffuse="2EFFFFFF">lumen/pill.png</texturenofocus>
				<onclick condition="$EXP[LumenNextLastPlayed]">PlayMedia($ESCINFO[Container(5110).ListItem.FileNameAndPath],resume)</onclick>
				<onclick condition="$EXP[LumenNextAfterLast]">PlayMedia($ESCINFO[Container(5111).ListItem.FileNameAndPath],resume)</onclick>
				<onclick condition="$EXP[LumenNextFirstUnwatched]">PlayMedia($ESCINFO[Container(5112).ListItem.FileNameAndPath],resume)</onclick>
				<onclick condition="$EXP[LumenNextWatchAgain]">PlayMedia($ESCINFO[Container(5113).ListItem.FileNameAndPath],noresume)</onclick>
				<onup>noop</onup>
				<onleft>noop</onleft>
				<onright>noop</onright>
