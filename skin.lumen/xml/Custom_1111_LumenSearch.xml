<?xml version="1.0" encoding="UTF-8"?>
<!-- Lumen search (Search tab): Kodi's own keyboard sets Skin.String(lumen.search), so phone remotes keep
     working; DialogKeyboard.xml shows live results while typing. scripts/lumen_search.py builds the rows' paths
     (Timers.xml runs it; Includes_Lumen.xml: LumenSearchFresh). -->
<window type="window" id="1111">
	<!-- the mode the page opened in: Timers.xml (lumensearchmode) sends it Home if kids mode changes while it's open -->
	<onload condition="$EXP[LumenKids]">SetProperty(lumen.searchkids,1,home)</onload>
	<onload condition="!$EXP[LumenKids]">ClearProperty(lumen.searchkids,home)</onload>
	<defaultcontrol>100</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<control type="group">
			<visible>!String.IsEmpty(Skin.String(lumen.search))</visible>
			<include content="LumenBackdrop">
				<param name="image" value="$VAR[LumenSearchFanart]" />
			</include>
		</control>

		<!-- search field -->
		<control type="group">
			<left>lm_margin</left>
			<top>48</top>
			<visible>!Window.IsVisible(virtualkeyboard)</visible>
			<include>LumenFadeInWindow</include>
			<control type="button" id="100">
				<width>1100</width>
				<height>84</height>
				<label></label>
				<font></font>
				<texturefocus border="42" colordiffuse="FFFFFFFF">lumen/pill.png</texturefocus>
				<texturenofocus border="42" colordiffuse="1FFFFFFF">lumen/pill.png</texturenofocus>
				<onclick>Skin.SetString(lumen.search)</onclick>
				<onup>noop</onup>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<ondown>5201</ondown>
			</control>
			<control type="image">
				<left>32</left>
				<top>24</top>
				<width>36</width>
				<height>36</height>
				<texture colordiffuse="focus_text">lumen/icons/search.png</texture>
				<visible>Control.HasFocus(100)</visible>
			</control>
			<control type="image">
				<left>32</left>
				<top>24</top>
				<width>36</width>
				<height>36</height>
				<texture colordiffuse="text_dim">lumen/icons/search.png</texture>
				<visible>!Control.HasFocus(100)</visible>
			</control>
			<control type="label">
				<left>92</left>
				<width>970</width>
				<height>84</height>
				<aligny>center</aligny>
				<font>lm_headline</font>
				<textcolor>focus_text</textcolor>
				<label>$INFO[Skin.String(lumen.search)]</label>
				<visible>Control.HasFocus(100)</visible>
			</control>
			<control type="label">
				<left>92</left>
				<width>970</width>
				<height>84</height>
				<aligny>center</aligny>
				<font>lm_headline</font>
				<textcolor>text</textcolor>
				<label>$INFO[Skin.String(lumen.search)]</label>
				<visible>!Control.HasFocus(100)</visible>
			</control>
			<control type="label">
				<left>92</left>
				<width>970</width>
				<height>84</height>
				<aligny>center</aligny>
				<font>lm_headline</font>
				<textcolor>text_mute</textcolor>
				<label>Movies, TV shows, actors, directors</label>
				<visible>String.IsEmpty(Skin.String(lumen.search))</visible>
			</control>
		</control>

		<!-- lists sit straight in the grouplist: a list in a hidden group never reloads. Up/down follow the
		     grouplist order; the header and gap ids let Kodi step past an empty row. -->
		<!-- hidden while the paths are for another text or mode -->
		<control type="group" id="9199">
			<top>170</top>
			<visible>$EXP[LumenSearchFresh] + !Window.IsVisible(virtualkeyboard)</visible>
			<control type="grouplist" id="9200">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>910</height>
				<orientation>vertical</orientation>
				<itemgap>0</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<onup>100</onup>
				<ondown>noop</ondown>
				<scrolltime tween="cubic" easing="out">380</scrolltime>
				<control type="group" id="6201">
					<height>44</height>
					<visible>Integer.IsGreater(Container(5201).NumItems,0) | Container(5201).IsUpdating</visible>
					<include content="LumenRowHeader">
						<param name="header" value="$LOCALIZE[342]" />
					</include>
				</control>
				<include content="LumenPosterList">
					<param name="id" value="5201" />
					<param name="top" value="0" />
					<param name="visible" value="Integer.IsGreater(Container(5201).NumItems,0) | Container(5201).IsUpdating" />
					<param name="path" value="$VAR[LumenSearchMoviesPath]" />
					<param name="sortby" value="title" />
					<param name="limit" value="50" />
				</include>
				<control type="image" id="6211">
					<height>36</height>
					<texture />
					<visible>Integer.IsGreater(Container(5201).NumItems,0) | Container(5201).IsUpdating</visible>
				</control>
				<control type="group" id="6202">
					<height>44</height>
					<visible>Integer.IsGreater(Container(5202).NumItems,0) | Container(5202).IsUpdating</visible>
					<include content="LumenRowHeader">
						<param name="header" value="$LOCALIZE[20343]" />
					</include>
				</control>
				<include content="LumenLandscapeList">
					<param name="id" value="5202" />
					<param name="top" value="0" />
					<param name="visible" value="Integer.IsGreater(Container(5202).NumItems,0) | Container(5202).IsUpdating" />
					<param name="path" value="$VAR[LumenSearchShowsPath]" />
					<param name="sortby" value="title" />
					<param name="limit" value="50" />
				</include>
				<control type="image" id="6212">
					<height>126</height>
					<texture />
					<visible>Integer.IsGreater(Container(5202).NumItems,0) | Container(5202).IsUpdating</visible>
				</control>
				<control type="group" id="6203">
					<height>44</height>
					<visible>!$EXP[LumenKids] + [Integer.IsGreater(Container(5203).NumItems,0) | Container(5203).IsUpdating]</visible>
					<include content="LumenRowHeader">
						<param name="header" value="Cast &amp; crew: “$INFO[Skin.String(lumen.search)]”" />
					</include>
				</control>
				<include content="LumenPosterList">
					<param name="id" value="5203" />
					<param name="top" value="0" />
					<param name="visible" value="!$EXP[LumenKids] + [Integer.IsGreater(Container(5203).NumItems,0) | Container(5203).IsUpdating]" />
					<param name="path" value="$VAR[LumenSearchPeoplePath]" />
					<param name="sortby" value="year" />
					<param name="sortorder" value="descending" />
					<param name="limit" value="50" />
				</include>
				<control type="image" id="6213">
					<height>36</height>
					<texture />
					<visible>!$EXP[LumenKids] + [Integer.IsGreater(Container(5203).NumItems,0) | Container(5203).IsUpdating]</visible>
				</control>
			</control>
			<control type="label">
				<left>lm_margin</left>
				<top>40</top>
				<width>1700</width>
				<height>44</height>
				<font>lm_headline</font>
				<textcolor>text_dim</textcolor>
				<label>No matches for “$INFO[Skin.String(lumen.search)]”</label>
				<visible>!Container(5201).IsUpdating + !Container(5202).IsUpdating + !Integer.IsGreater(Container(5201).NumItems,0) + !Integer.IsGreater(Container(5202).NumItems,0) + [$EXP[LumenKids] | [!Container(5203).IsUpdating + !Integer.IsGreater(Container(5203).NumItems,0)]]</visible>
			</control>
		</control>

		<!-- nothing typed yet -->
		<control type="label" id="1190">
			<left>lm_margin</left>
			<top>210</top>
			<width>1700</width>
			<height>44</height>
			<font>lm_headline</font>
			<textcolor>text_dim</textcolor>
			<label>$VAR[LumenSearchHint]</label>
			<visible>String.IsEmpty(Skin.String(lumen.search)) + !Window.IsVisible(virtualkeyboard)</visible>
		</control>
		<include>LumenClock</include>
	</controls>
</window>
