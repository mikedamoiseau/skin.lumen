<?xml version="1.0" encoding="UTF-8"?>
<!-- Lumen component library: backdrop, tab bar, hero, metadata, cards, rows. -->
<includes>
	<constant name="lm_margin">110</constant>
	<constant name="lm_poster_w">210</constant>
	<constant name="lm_poster_h">315</constant>
	<constant name="lm_land_w">384</constant>
	<constant name="lm_land_h">216</constant>

	<!-- ============ Animations ============ -->
	<include name="LumenFadeInWindow">
		<animation effect="fade" start="0" end="100" time="320" tween="sine" easing="out">WindowOpen</animation>
		<animation effect="fade" start="100" end="0" time="200" tween="sine" easing="in">WindowClose</animation>
	</include>
	<include name="LumenRiseIn">
		<param name="delay">0</param>
		<definition>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="420" delay="$PARAM[delay]" tween="sine" easing="out" />
				<effect type="slide" start="0,48" end="0,0" time="560" delay="$PARAM[delay]" tween="cubic" easing="out" />
			</animation>
			<animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
		</definition>
	</include>
	<include name="LumenKenBurns">
		<animation effect="zoom" start="100" end="108" center="960,540" time="26000" tween="sine" easing="inout" pulse="true" condition="Skin.HasSetting(lumen_kenburns)">Conditional</animation>
	</include>

	<!-- ============ Backdrop ============ -->
	<include name="LumenBackdrop">
		<param name="image">$VAR[LumenHomeFanart]</param>
		<param name="dim">FFFFFFFF</param>
		<param name="scrim">lumen/hero_scrim.png</param>
		<definition>
			<control type="group">
				<include>LumenKenBurns</include>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1920</width>
					<height>1080</height>
					<aspectratio>scale</aspectratio>
					<fadetime>500</fadetime>
					<texture background="true" colordiffuse="$PARAM[dim]">$PARAM[image]</texture>
				</control>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<texture>$PARAM[scrim]</texture>
			</control>
		</definition>
	</include>

	<!-- ============ Top bar: tvOS-style tabs + clock ============ -->
	<include name="LumenTabButton">
		<param name="nofocustex"></param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>60</height>
				<label>$PARAM[label]</label>
				<font>lm_tab</font>
				<textoffsetx>30</textoffsetx>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>text_dim</textcolor>
				<focusedcolor>focus_text</focusedcolor>
				<texturefocus border="30" colordiffuse="FFFFFFFF">lumen/pill.png</texturefocus>
				<texturenofocus border="30" colordiffuse="24FFFFFF">$PARAM[nofocustex]</texturenofocus>
				<animation effect="zoom" start="100" end="106" center="auto" time="200" tween="cubic" easing="out" reversible="false">Focus</animation>
				<animation effect="zoom" start="106" end="100" center="auto" time="200" tween="cubic" easing="out" reversible="false">UnFocus</animation>
				<onclick>$PARAM[onclick]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="LumenTabBar">
		<param name="tex10"></param>
		<param name="tex11"></param>
		<param name="tex12"></param>
		<param name="tex13"></param>
		<param name="tex14"></param>
		<param name="tex15"></param>
		<param name="tex16"></param>
		<param name="tex17"></param>
		<param name="ondown">9100</param>
		<definition>
			<control type="group" id="9010">
				<top>40</top>
				<height>64</height>
				<include>LumenFadeInWindow</include>
				<control type="grouplist" id="9000">
					<left>0</left>
					<width>1920</width>
					<height>64</height>
					<top>2</top>
					<orientation>horizontal</orientation>
					<align>center</align>
					<itemgap>6</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<ondown>$PARAM[ondown]</ondown>
					<onback>SetFocus($PARAM[ondown])</onback>
					<include content="LumenTabButton">
						<param name="id" value="10" />
						<param name="nofocustex" value="$PARAM[tex10]" />
						<param name="label" value="$LOCALIZE[10000]" />
						<param name="onclick" value="ActivateWindow(home)" />
						<param name="visible" value="true" />
					</include>
					<include content="LumenTabButton">
						<param name="id" value="11" />
						<param name="nofocustex" value="$PARAM[tex11]" />
						<param name="label" value="$LOCALIZE[342]" />
						<param name="onclick" value="ActivateWindow(Videos,videodb://movies/titles/,return)" />
						<param name="visible" value="Library.HasContent(movies)" />
					</include>
					<include content="LumenTabButton">
						<param name="id" value="12" />
						<param name="nofocustex" value="$PARAM[tex12]" />
						<param name="label" value="$LOCALIZE[20343]" />
						<param name="onclick" value="ActivateWindow(Videos,videodb://tvshows/titles/,return)" />
						<param name="visible" value="Library.HasContent(tvshows)" />
					</include>
					<include content="LumenTabButton">
						<param name="id" value="13" />
						<param name="nofocustex" value="$PARAM[tex13]" />
						<param name="label" value="Collections" />
						<param name="onclick" value="ActivateWindow(Videos,videodb://movies/sets/,return)" />
						<param name="visible" value="Library.HasContent(moviesets)" />
					</include>
					<include content="LumenTabButton">
						<param name="id" value="14" />
						<param name="nofocustex" value="$PARAM[tex14]" />
						<param name="label" value="$LOCALIZE[1036]" />
						<param name="onclick" value="ActivateWindow(favouritesbrowser)" />
						<param name="visible" value="true" />
					</include>
					<include content="LumenTabButton">
						<param name="id" value="15" />
						<param name="nofocustex" value="$PARAM[tex15]" />
						<param name="label" value="$LOCALIZE[24001]" />
						<param name="onclick" value="ActivateWindow(Videos,addons://sources/video/,return)" />
						<param name="visible" value="true" />
					</include>
					<include content="LumenTabButton">
						<param name="id" value="16" />
						<param name="nofocustex" value="$PARAM[tex16]" />
						<param name="label" value="$LOCALIZE[137]" />
						<param name="onclick" value="ActivateWindow(1107)" />
						<param name="visible" value="true" />
					</include>
					<include content="LumenTabButton">
						<param name="id" value="17" />
						<param name="nofocustex" value="$PARAM[tex17]" />
						<param name="label" value="$LOCALIZE[5]" />
						<param name="onclick" value="ActivateWindow(settings)" />
						<param name="visible" value="true" />
					</include>
					<!-- power: icon-only, opens Kodi's power menu (items depend on the platform) -->
					<control type="radiobutton" id="18">
						<width>60</width>
						<height>60</height>
						<label>$LOCALIZE[33060]</label>
						<font></font>
						<texturefocus border="30" colordiffuse="FFFFFFFF">lumen/pill.png</texturefocus>
						<texturenofocus />
						<radioposx>14</radioposx>
						<radioposy>14</radioposy>
						<radiowidth>32</radiowidth>
						<radioheight>32</radioheight>
						<textureradioonfocus colordiffuse="focus_text">lumen/icons/power.png</textureradioonfocus>
						<textureradioofffocus colordiffuse="focus_text">lumen/icons/power.png</textureradioofffocus>
						<textureradioonnofocus colordiffuse="text_dim">lumen/icons/power.png</textureradioonnofocus>
						<textureradiooffnofocus colordiffuse="text_dim">lumen/icons/power.png</textureradiooffnofocus>
						<animation effect="zoom" start="100" end="106" center="auto" time="200" tween="cubic" easing="out" reversible="false">Focus</animation>
						<animation effect="zoom" start="106" end="100" center="auto" time="200" tween="cubic" easing="out" reversible="false">UnFocus</animation>
						<onclick>ActivateWindow(shutdownmenu)</onclick>
					</control>
				</control>
			</control>
		</definition>
	</include>
	<include name="LumenClock">
		<control type="group">
			<right>80</right>
			<top>48</top>
			<width>300</width>
			<height>50</height>
			<include>LumenFadeInWindow</include>
			<control type="label">
				<right>0</right>
				<width>300</width>
				<height>50</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>lm_clock</font>
				<textcolor>text</textcolor>
				<label>$INFO[System.Time]</label>
			</control>
		</control>
	</include>

	<!-- ============ Metadata line (year · genre · runtime · rating · badges) ============ -->
	<include name="LumenBadge">
		<control type="button">
			<width>auto</width>
			<height>34</height>
			<label>$PARAM[label]</label>
			<font>lm_micro</font>
			<textoffsetx>12</textoffsetx>
			<align>center</align>
			<aligny>center</aligny>
			<textcolor>text</textcolor>
			<disabledcolor>text</disabledcolor>
			<texturenofocus border="6" colordiffuse="B3FFFFFF">lumen/rr6_stroke.png</texturenofocus>
			<texturefocus border="6" colordiffuse="B3FFFFFF">lumen/rr6_stroke.png</texturefocus>
			<enable>false</enable>
			<visible>$PARAM[visible]</visible>
		</control>
	</include>
	<include name="LumenMetaText">
		<control type="label">
			<width>auto</width>
			<height>34</height>
			<aligny>center</aligny>
			<font>lm_label</font>
			<textcolor>text_dim</textcolor>
			<label>$PARAM[label]</label>
			<visible>$PARAM[visible]</visible>
		</control>
	</include>
	<include name="LumenMetaLine">
		<!-- $PARAM[item] is "ListItem" or "Container(id).ListItem" -->
		<param name="item">ListItem</param>
		<param name="align">left</param>
		<param name="width">1200</param>
		<definition>
			<control type="grouplist">
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<width>$PARAM[width]</width>
				<height>34</height>
				<align>$PARAM[align]</align>
				<usecontrolcoords>true</usecontrolcoords>
				<include content="LumenMetaText">
					<param name="label" value="$INFO[$PARAM[item].Season,S, ]$INFO[$PARAM[item].Episode,E,  ·  ]$INFO[$PARAM[item].Title]" />
					<param name="visible" value="String.IsEqual($PARAM[item].DBType,episode)" />
				</include>
				<include content="LumenMetaText">
					<param name="label" value="$INFO[$PARAM[item].Label]" />
					<param name="visible" value="String.IsEqual($PARAM[item].DBType,season)" />
				</include>
				<include content="LumenMetaText">
					<param name="label" value="$INFO[$PARAM[item].Year]" />
					<param name="visible" value="!String.IsEqual($PARAM[item].DBType,episode) + !String.IsEqual($PARAM[item].DBType,season) + !String.IsEmpty($PARAM[item].Year)" />
				</include>
				<include content="LumenMetaText">
					<param name="label" value="$INFO[$PARAM[item].Year,·  ]" />
					<param name="visible" value="String.IsEqual($PARAM[item].DBType,season) + !String.IsEmpty($PARAM[item].Year)" />
				</include>
				<include content="LumenMetaText">
					<param name="label" value="$INFO[$PARAM[item].Genre,·  ]" />
					<param name="visible" value="!String.IsEqual($PARAM[item].DBType,episode) + !String.IsEmpty($PARAM[item].Genre)" />
				</include>
				<include content="LumenMetaText">
					<param name="label" value="·  $INFO[$PARAM[item].Duration(h),,h ]$INFO[$PARAM[item].Duration(m),,m]" />
					<param name="visible" value="!String.IsEmpty($PARAM[item].Duration) + !String.IsEqual($PARAM[item].DBType,tvshow) + !String.IsEqual($PARAM[item].Duration(h),0)" />
				</include>
				<include content="LumenMetaText">
					<param name="label" value="·  $INFO[$PARAM[item].Duration(m),,m]" />
					<param name="visible" value="!String.IsEmpty($PARAM[item].Duration) + !String.IsEqual($PARAM[item].DBType,tvshow) + String.IsEqual($PARAM[item].Duration(h),0)" />
				</include>
				<include content="LumenMetaText">
					<param name="label" value="$INFO[$PARAM[item].Property(TotalSeasons),·  , $LOCALIZE[33054]]" />
					<param name="visible" value="String.IsEqual($PARAM[item].DBType,tvshow) + Integer.IsGreater($PARAM[item].Property(TotalSeasons),1)" />
				</include>
				<include content="LumenMetaText">
					<param name="label" value="$INFO[$PARAM[item].Property(UnWatchedEpisodes),·  , $LOCALIZE[16101]]" />
					<param name="visible" value="String.IsEqual($PARAM[item].DBType,tvshow) + Integer.IsGreater($PARAM[item].Property(UnWatchedEpisodes),0)" />
				</include>
				<control type="image">
					<width>10</width>
					<height>34</height>
					<texture />
				</control>
				<control type="image">
					<width>22</width>
					<height>34</height>
					<aspectratio>keep</aspectratio>
					<texture colordiffuse="accent">lumen/icons/star.png</texture>
					<visible>Integer.IsGreater($PARAM[item].Rating,0)</visible>
				</control>
				<include content="LumenMetaText">
					<param name="label" value="$INFO[$PARAM[item].Rating]" />
					<param name="visible" value="Integer.IsGreater($PARAM[item].Rating,0)" />
				</include>
				<control type="image">
					<width>4</width>
					<height>34</height>
					<texture />
				</control>
				<include content="LumenBadge">
					<param name="label" value="4K" />
					<param name="visible" value="String.IsEqual($PARAM[item].VideoResolution,4K)" />
				</include>
				<include content="LumenBadge">
					<param name="label" value="HD" />
					<param name="visible" value="String.IsEqual($PARAM[item].VideoResolution,1080) | String.IsEqual($PARAM[item].VideoResolution,720)" />
				</include>
				<include content="LumenBadge">
					<param name="label" value="DOLBY VISION" />
					<param name="visible" value="String.IsEqual($PARAM[item].HdrType,dolbyvision)" />
				</include>
				<include content="LumenBadge">
					<param name="label" value="HDR" />
					<param name="visible" value="String.IsEqual($PARAM[item].HdrType,hdr10) | String.IsEqual($PARAM[item].HdrType,hlg)" />
				</include>
				<include content="LumenBadge">
					<param name="label" value="7.1" />
					<param name="visible" value="String.IsEqual($PARAM[item].AudioChannels,8)" />
				</include>
				<include content="LumenBadge">
					<param name="label" value="5.1" />
					<param name="visible" value="String.IsEqual($PARAM[item].AudioChannels,6)" />
				</include>
				<include content="LumenBadge">
					<param name="label" value="CC" />
					<param name="visible" value="!String.IsEmpty($PARAM[item].SubtitleLanguage)" />
				</include>
			</control>
		</definition>
	</include>

	<!-- ============ Hero (logo / title, metadata, plot) ============ -->
	<include name="LumenHero">
		<param name="item">ListItem</param>
		<param name="visible">true</param>
		<param name="top">150</param>
		<definition>
			<control type="group">
				<left>lm_margin</left>
				<top>$PARAM[top]</top>
				<width>900</width>
				<height>420</height>
				<visible>$PARAM[visible]</visible>
				<animation effect="fade" time="260" tween="sine" easing="out">VisibleChange</animation>
				<!-- clear logo, then the show's logo for episodes, then a big title -->
				<control type="image">
					<width>620</width>
					<height>200</height>
					<aspectratio align="left" aligny="bottom">keep</aspectratio>
					<fadetime>300</fadetime>
					<texture background="true">$INFO[$PARAM[item].Art(clearlogo)]</texture>
				</control>
				<control type="image">
					<width>620</width>
					<height>200</height>
					<aspectratio align="left" aligny="bottom">keep</aspectratio>
					<fadetime>300</fadetime>
					<texture background="true">$INFO[$PARAM[item].Art(tvshow.clearlogo)]</texture>
					<visible>String.IsEmpty($PARAM[item].Art(clearlogo))</visible>
				</control>
				<control type="textbox">
					<top>20</top>
					<width>880</width>
					<height>180</height>
					<aligny>bottom</aligny>
					<font>lm_title_l</font>
					<textcolor>text</textcolor>
					<shadowcolor>text_shadow</shadowcolor>
					<label>$INFO[$PARAM[item].TVShowTitle]</label>
					<visible>String.IsEqual($PARAM[item].DBType,episode) + String.IsEmpty($PARAM[item].Art(clearlogo)) + String.IsEmpty($PARAM[item].Art(tvshow.clearlogo))</visible>
				</control>
				<control type="textbox">
					<top>20</top>
					<width>880</width>
					<height>180</height>
					<aligny>bottom</aligny>
					<font>lm_title_l</font>
					<textcolor>text</textcolor>
					<shadowcolor>text_shadow</shadowcolor>
					<label>$INFO[$PARAM[item].Label]</label>
					<visible>!String.IsEqual($PARAM[item].DBType,episode) + String.IsEmpty($PARAM[item].Art(clearlogo)) + String.IsEmpty($PARAM[item].Art(tvshow.clearlogo))</visible>
				</control>
				<control type="group">
					<top>232</top>
					<include content="LumenMetaLine">
						<param name="item" value="$PARAM[item]" />
					</include>
				</control>
				<control type="textbox">
					<top>290</top>
					<width>860</width>
					<height>100</height>
					<font>lm_body</font>
					<textcolor>text_dim</textcolor>
					<label>$INFO[$PARAM[item].Plot]</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============ Cards ============ -->
	<include name="LumenCardFocus">
		<!-- lift + shadow: wraps a card that is $PARAM[w] x $PARAM[h] -->
		<animation type="Focus" reversible="false">
			<effect type="zoom" start="100" end="110" center="$PARAM[cx],$PARAM[cy]" time="260" tween="cubic" easing="out" />
		</animation>
		<animation type="UnFocus" reversible="false">
			<effect type="zoom" start="110" end="100" center="$PARAM[cx],$PARAM[cy]" time="200" tween="cubic" easing="out" />
		</animation>
	</include>
	<include name="LumenPosterCard">
		<param name="focused">false</param>
		<definition>
			<control type="image">
				<left>-40</left>
				<top>-26</top>
				<width>290</width>
				<height>395</height>
				<texture border="52">lumen/shadow_card.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="image">
				<width>lm_poster_w</width>
				<height>lm_poster_h</height>
				<texture border="12" colordiffuse="card_bg">lumen/rr14.png</texture>
				<visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(thumb)) + !ListItem.IsParentFolder</visible>
			</control>
			<control type="group">
				<visible>ListItem.IsParentFolder</visible>
				<control type="image">
					<width>lm_poster_w</width>
					<height>lm_poster_h</height>
					<texture border="12" colordiffuse="1AFFFFFF">lumen/rr14.png</texture>
				</control>
				<control type="image">
					<left>73</left>
					<top>125</top>
					<width>64</width>
					<height>64</height>
					<texture colordiffuse="text_dim">lumen/icons/chevron_left.png</texture>
				</control>
			</control>
			<control type="label">
				<left>16</left>
				<width>178</width>
				<height>lm_poster_h</height>
				<align>center</align>
				<aligny>center</aligny>
				<wrapmultiline>true</wrapmultiline>
				<font>lm_label_bold</font>
				<textcolor>text_mute</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(thumb)) + !ListItem.IsParentFolder</visible>
			</control>
			<control type="image">
				<width>lm_poster_w</width>
				<height>lm_poster_h</height>
				<aspectratio>scale</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true" diffuse="lumen/mask_poster.png">$VAR[LumenPosterArt]</texture>
			</control>
			<control type="group">
				<visible>$PARAM[focused]</visible>
				<control type="image">
					<width>lm_poster_w</width>
					<height>lm_poster_h</height>
					<texture>lumen/gloss_poster.png</texture>
				</control>
				<control type="image">
					<width>lm_poster_w</width>
					<height>lm_poster_h</height>
					<texture border="12" colordiffuse="66FFFFFF">lumen/rr14_stroke1.png</texture>
				</control>
			</control>
			<include>LumenCardBadges</include>
			<control type="group">
				<left>14</left>
				<top>297</top>
				<visible>ListItem.IsResumable + !String.IsEqual(ListItem.DBType,tvshow)</visible>
				<include content="LumenProgress">
					<param name="width" value="182" />
					<param name="info" value="ListItem.PercentPlayed" />
				</include>
			</control>
			<control type="group">
				<left>14</left>
				<top>297</top>
				<visible>String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.Property(WatchedEpisodePercent),0)</visible>
				<include content="LumenProgress">
					<param name="width" value="182" />
					<param name="info" value="ListItem.Property(WatchedEpisodePercent)" />
				</include>
			</control>
		</definition>
	</include>
	<include name="LumenCardBadges">
		<!-- watched tick / unwatched-episode counter, top-right corner -->
		<control type="group">
			<right>10</right>
			<top>10</top>
			<width>40</width>
			<height>40</height>
			<visible>Integer.IsGreater(ListItem.PlayCount,0) + !String.IsEqual(ListItem.DBType,tvshow) + !String.IsEqual(ListItem.DBType,set)</visible>
			<control type="image">
				<texture colordiffuse="E6FFFFFF">lumen/dot.png</texture>
			</control>
			<control type="image">
				<left>8</left>
				<top>8</top>
				<width>24</width>
				<height>24</height>
				<texture colordiffuse="focus_text">lumen/icons/check.png</texture>
			</control>
		</control>
		<control type="group">
			<right>10</right>
			<top>10</top>
			<width>52</width>
			<height>34</height>
