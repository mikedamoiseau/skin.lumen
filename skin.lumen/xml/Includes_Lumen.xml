		<value condition="Player.Playing">osd/fullscreen/buttons/pause.png</value>
		<value>osd/fullscreen/buttons/play.png</value>
	</variable>
	<variable name="LumenPlayerLogo">
		<value condition="!String.IsEmpty(Player.Art(clearlogo))">$INFO[Player.Art(clearlogo)]</value>
		<value>$INFO[Player.Art(tvshow.clearlogo)]</value>
	</variable>
	<variable name="LumenPlayerTitle">
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="!String.IsEmpty(VideoPlayer.Title)">$INFO[VideoPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>
	<variable name="LumenPlayerSubtitle">
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.Season,S]$INFO[VideoPlayer.Episode, E]$INFO[VideoPlayer.Title,  ·  ]</value>
		<value condition="!String.IsEmpty(Player.Art(clearlogo))">$INFO[VideoPlayer.Year]</value>
		<value>$INFO[VideoPlayer.Year]$INFO[VideoPlayer.Genre,  ·  ]</value>
	</variable>
	<variable name="LumenPlayerResSuffix">
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,1080) | String.IsEqual(VideoPlayer.VideoResolution,720) | String.IsEqual(VideoPlayer.VideoResolution,576) | String.IsEqual(VideoPlayer.VideoResolution,480)">p</value>
	</variable>
	<variable name="LumenPlayerHdr">
		<value condition="String.IsEqual(VideoPlayer.HdrType,dolbyvision)">DOLBY VISION</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10)">HDR10</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hlg)">HLG</value>
		<value>[UPPERCASE]$INFO[VideoPlayer.HdrType][/UPPERCASE]</value>
	</variable>
	<variable name="LumenPlayerChannels">
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,8)"> 7.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,6)"> 5.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,2)"> 2.0</value>
	</variable>
	<variable name="LumenPlayerStateIcon">
		<value condition="Player.Paused">lumen/icons/pause.png</value>
		<value condition="Player.Rewinding">osd/fullscreen/buttons/rewind.png</value>
		<value condition="Player.Forwarding">osd/fullscreen/buttons/forward.png</value>
		<value>lumen/icons/play.png</value>
	</variable>
	<variable name="LumenPlayerStateLabel">
		<value condition="Player.Paused">Paused</value>
		<value condition="Player.Forwarding | Player.Rewinding">$INFO[Player.PlaySpeed,,×]</value>
	</variable>
	<variable name="LumenPlayerElapsed">
		<value condition="Player.Seeking | !String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekTime]</value>
		<value>$INFO[Player.Time]</value>
	</variable>
	<variable name="LumenSkinSettingHelp">
		<value condition="Control.HasFocus(901)">Slowly zooms the backdrop on Home, library and detail pages.[CR][CR]Looks great, but the whole screen redraws every frame: on a Raspberry Pi menus drop to about half the frame rate. Off by default.</value>
	</variable>
</includes>
