<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Movies</name>
    <match>all</match>
    <rule field="tag" operator="is">
        <value>Cinematheque Kids</value>
    </rule>
    <group>none</group>
    <order direction="ascending">sorttitle</order>
</smartplaylist>
